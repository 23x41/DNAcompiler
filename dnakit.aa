# =====================================================================
# dnakit.aa  --  GATC DNA toolkit: a sequence-analysis shell for the GATC VM
#
#   python3 GATCnux.py run dnakit.aa --no-banner --fs --max-steps 2000000000
#   echo "orf genome.fa 150" | python3 GATCnux.py run dnakit.aa --no-banner --fs --max-steps 2000000000
#
# info FILE              records, length, base counts, GC% and GC skew
# view FILE [START] [LEN]     coloured bases, numbered rows of 60
# gc FILE [WINDOW]       GC% along the sequence as a bar chart
# revcomp FILE [OUT]     reverse complement (IUPAC aware) as FASTA
# orf FILE [MINAA]       open reading frames, ATG..stop, all six frames
# translate FILE START END [-]   protein of a region, either strand
# dis FILE [START] [COUNT]       codons as VM instructions, in paint's colours
# codon XYZ              one codon: colour, instruction, amino acid
# ls [DIR]  cd [DIR]  pwd  help  exit        and  > file / >> file
#
# Every algorithm here is GATC assembly; GATCnux.py --fs only opens, reads,
# seeks and writes files.  Generated from dnakit.tpl by gen_aa.py.
# Memory map (generated):
#       0..  255  LINE
#     256..  543  ARGBUF
#     544..  575  ARGV
#     576.. 1175  PA
#    1176.. 1431  PB
#    1432.. 1951  BLK
#    1952.. 2251  OB
#    2252.. 2507  NAME
#    2508.. 2717  LBUF
#    2718.. 2781  EBUF
#    2782.. 3037  BT
#    3038.. 3165  CT
#    3166.. 3229  CC
#    3230.. 3232  FO
#    3233.. 3235  MS
#    3236.. 3238  MC
#    3239.. 3243  CNT
#    3244.. 3394  variables (151)
#    3395.. 3998  strings (31)   free: 97 cells
# =====================================================================




MAIN B

# =====================================================================
#  host bridge
# =====================================================================

:SYS                       # (cmd -- status)
  4128 T 4133 F R
:ERRB                      # following output goes to stderr
  1 4129 T 25 SYS C ! R
:ERRE                      # back to stdout (or the redirect file)
  0 4129 T 25 SYS C ! R
:STATP                     # (path follow -- ok)  sets $ssize $stype $smode $smtime
  4130 T 4129 T 1 SYS C D STPF J
  4134 F 3244 T 4135 F 3245 T 4136 F 3246 T 4137 F 3247 T
:STPF
  R
:FOPEN                     # (path mode -- ok)  handle in %FR1
  4130 T 4129 T 9 SYS C R
:FCLOSE                    # (fd --)
  4129 T 12 SYS C ! R
:BREAD                     # (fd -- n)  read up to 512 bytes into BLK, 0 at EOF or error
  4129 T 1432 4130 T 512 4131 T 10 SYS C BRFAIL J
  4134 F R
:BRFAIL
  0 R
:FSEEK                     # (fd offset --)  absolute position
  4130 T 4129 T 0 4131 T 0 4132 T 13 SYS C ! R
:SAMEF                     # (a b -- same)  %FR2 = b is inside a
  4130 T 4129 T 24 SYS C ! 4134 F R
:TTYCHK
  21 SYS C ! 4134 F 3248 T 4135 F 3249 T 4136 F 3250 T R
:TIMEINIT
  18 SYS C ! 4134 F 3251 T 4135 F 3252 T R

# =====================================================================
#  strings
# =====================================================================

:STRLEN                    # (a -- n)
  D
:SLLP
  D F SLEND J
  + SLLP B
:SLEND
  SWAP S R

:STREQ                     # (a b -- flag)
  3253 T 3254 T
:SQLP
  3253 F F 3254 F F = SQNO *
  3253 F F SQYES J
  3253 PSTO 3254 PSTO SQLP B
:SQNO
  0 R
:SQYES
  1 R

:STRNCPY                   # (src dst max --)  copy at most max-1 bytes; $ctr = 1 if cut
  - 3255 T 3256 T 3257 T 0 3258 T
:SNLP
  3257 F F D SNEND J
  3255 F SNFULL J
  3256 F T
  3257 PSTO 3256 PSTO 3255 F - 3255 T
  SNLP B
:SNFULL
  1 3258 T
:SNEND
  ! 0 3256 F T R

:APPENDS                   # (src dst max -- ok)  append src to the string at dst
  3259 T 3260 T 3261 T
  3260 F STRLEN C 3262 T
  3261 F 3260 F 3262 F A 3259 F 3262 F S STRNCPY C
  3258 F N R

:PATHJOIN                  # (src buf -- ok)  buf = buf "/" src  (no doubled slash)
  3263 T 3264 T
  3263 F STRLEN C D PJNOSL J
  - 3263 F A F 47 E PJCAT *
  3703 3263 F 600 APPENDS C PJFAIL J
  PJCAT B
:PJNOSL
  !
:PJCAT
  3264 F 3263 F 600 APPENDS C R
:PJFAIL
  0 R

:ADDNAME                   # (buf -- ok)  buf = buf "/" NAME
  2252 SWAP PATHJOIN C R

:BASENAME                  # (p -- q)  q = text after the last '/'
  D 3265 T
:BNLP
  D F BNEND J
  D F 47 E BNSL *
  + BNLP B
:BNSL
  + D 3265 T BNLP B
:BNEND
  ! 3265 F R

:HASWILD                   # (p -- flag)  contains * or ?
:HWLP
  D F D HWNO J
  D 42 E SWAP 63 E O HWYES *
  + HWLP B
:HWNO
  ] 0 R
:HWYES
  ! 1 R

:STRIPSL                   # (buf --)  drop trailing slashes, keep a lone "/"
  3266 T
:SSLP
  3266 F STRLEN C D 2 L SSDONE *
  - 3266 F A D F 47 = SSDONE *
  0 SWAP T SSLP B
:SSDONE
  ! R

:LOWER                     # (c -- c')
  D 65 L LWX *
  D 90 G LWX *
  32 O
:LWX
  R

:LOWERBUF                  # (buf --)
:LBLP
  D F LBEND J
  D F LOWER C OVER T + LBLP B
:LBEND
  ! R

:PARSENUM                  # (p -- n)  decimal; $nbad = 1 if empty or trailing junk
  3267 T 0 3268 T 0 3269 T
:PNLP
  3267 F F D 48 L OVER 57 G O PNEND *
  48 S 3268 F 10 M A 3268 T 3267 PSTO 3269 PSTO PNLP B
:PNEND
  3269 F N SWAP BOOL O 3270 T 3268 F R

:WMATCH                    # (pat str -- flag)  wildcard match: * any run, ? one byte
  3271 T 3272 T
  0 3273 T 0 3274 T 0 3275 T 0 3276 T
:WMLP
  3274 F 3271 F A F WMTAIL J
  3273 F 3272 F A F 3277 T
  3277 F 63 E WMADV *
  3277 F 42 E WMSTAR *
  3277 F 3274 F 3271 F A F E WMADV *
  3275 F WMNO J
  3275 F 3273 T 3276 PSTO 3276 F 3274 T WMLP B
:WMADV
  3273 PSTO 3274 PSTO WMLP B
:WMSTAR
  3273 F + D 3275 T 3273 T 3274 F 3276 T WMLP B
:WMTAIL
  3273 F 3272 F A F 42 = WMEND *
  3273 PSTO WMTAIL B
:WMEND
  3273 F 3272 F A F N R
:WMNO
  0 R

# =====================================================================
#  output
# =====================================================================

:WRITEN                    # (a n --)  raw bytes to stdout (UTF-8 safe, byte exact)
  D WNZ J
  4131 T 4130 T 1 4129 T 11 SYS C ! R
:WNZ
  ] R
:PUTS                      # (a --)
  D STRLEN C WRITEN C R

:SPACES                    # (k --)
  D 1 L SPEND *
  32 W - SPACES B
:SPEND
  ! R

:NUMW                      # (n -- digits)
  1 SWAP
:NWLP
  D 10 L NWEND *
  10 V SWAP + SWAP NWLP B
:NWEND
  ! R

:PADNUM                    # (n width --)  right aligned
  OVER NUMW C S SPACES C Y R

:PAD2                      # (n --)  two digits
  D 10 L P2Z *
  Y R
:P2Z
  48 W Y R

:HEXN                      # (n digits --)
  3278 T 3279 T
:HXLP
  3278 F HXEND J
  3278 F - D 3278 T 4 M 3279 F SWAP > 15 P
  D 10 L HXNUM *
  87 A W HXLP B
:HXNUM
  48 A W HXLP B
:HXEND
  R

:OCT4                      # (n --)  4 octal digits
  D 9 > 7 P Y D 6 > 7 P Y D 3 > 7 P Y 7 P Y R

:HUMAN                     # (n width --)  1023, 4.0K, 12M ... right aligned
  3280 T 3281 T
  3281 F 1024 L HUPLAIN *
  0 3282 T 1024 3283 T
:HULP
  3281 F 3283 F 1024 M L HUGO *
  3282 F 4 / HUGO *
  3283 F 1024 M 3283 T 3282 PSTO HULP B
:HUGO                      # rounds up, like GNU ls/du/df -h
  3281 F 10 M 3283 F A - 3283 F V 3284 T
  3284 F 100 L HUDEC *
  3281 F 3283 F A - 3283 F V
  D 1024 L HUINT *
  ! 10 3284 T 3283 F 1024 M 3283 T 3282 PSTO HUDEC B
:HUINT
  D NUMW C + 3280 F SWAP S SPACES C Y HUUNIT C R
:HUDEC
  3284 F 10 V NUMW C 3 A 3280 F SWAP S SPACES C
  3284 F 10 V Y 46 W 3284 F 10 MOD Y HUUNIT C R
:HUPLAIN
  3281 F 3280 F PADNUM C R
:HUUNIT
  3282 F
  D HUK J
  D 1 E HUM *
  D 2 E HUG *
  D 3 E HUT *
  ! 80 W R
:HUK
  ! 75 W R
:HUM
  ! 77 W R
:HUG
  ! 71 W R
:HUT
  ! 84 W R

:PERMS                     # (mode --)  rwxr-xr-x
  3285 T 8 3286 T
:PMLP
  3285 F 3286 F > 1 P
  3286 F 3 MOD
  SWAP PMDASH J
  D 2 E PMR *
  D 1 E PMW *
  ! 120 W PMNX B
:PMR
  ! 114 W PMNX B
:PMW
  ! 119 W PMNX B
:PMDASH
  ! 45 W
:PMNX
  3286 F PMEND J
  3286 F - 3286 T PMLP B
:PMEND
  R

:TYPECH                    # (type --)
  D 2 E TCD *
  D 3 E TCL *
  ! 45 W R
:TCD
  ! 100 W R
:TCL
  ! 108 W R

# civil date from a unix time (Howard Hinnant's days-to-civil), local time via $tzoff
:DATEFMT                   # (t --)  YYYY-MM-DD HH:MM[:SS]
  3252 F A
  D 0 L DFNEG *
:DFGO
  D 86400 V 3287 T 86400 MOD 3288 T
  3287 F 719468 A 3289 T
  3289 F 146097 V 3290 T
  3289 F 3290 F 146097 M S 3291 T
  3291 F 3291 F 1460 V S 3291 F 36524 V A 3291 F 146096 V S 365 V 3292 T
  3292 F 3290 F 400 M A 3293 T
  3291 F 3292 F 365 M 3292 F 4 V A 3292 F 100 V S S 3294 T
  3294 F 5 M 2 A 153 V 3295 T
  3294 F 3295 F 153 M 2 A 5 V S + 3296 T
  3295 F 10 L DFM1 *
  3295 F 9 S 3297 T DFM2 B
:DFM1
  3295 F 3 A 3297 T
:DFM2
  3297 F 2 ^ 3293 F A 3293 T
  3293 F Y 45 W 3297 F PAD2 C 45 W 3296 F PAD2 C
  32 W 3288 F 3600 V PAD2 C 58 W 3288 F 60 V 60 MOD PAD2 C
  3298 F DFRET J
  58 W 3288 F 60 MOD PAD2 C
:DFRET
  R
:DFNEG
  ! 0 DFGO B

# colours (only when stdout is a terminal)
:CRED
  3248 F CX1 J 27 W "[1;31m"
:CX1
  R
:CGRN
  3248 F CX2 J 27 W "[32m"
:CX2
  R
:CMAG
  3248 F CX3 J 27 W "[35m"
:CX3
  R
:CBLU
  3248 F CX4 J 27 W "[1;34m"
:CX4
  R
:CYEL
  3248 F CX5 J 27 W "[1;33m"
:CX5
  R
:CRST
  3248 F CX6 J 27 W "[0m"
:CX6
  R

:NAMECOL                   # (addr --)  print a name coloured by $etype / $emode
  3248 F NCPLAIN J
  3299 F 2 E NCDIR *
  3299 F 3 E NCLNK *
  3299 F 1 E 3300 F 73 P BOOL P NCEXE *
:NCPLAIN
  SAFEPUTS C R
:NCDIR
  27 W "[1;34m" NCGO B
:NCLNK
  27 W "[1;36m" NCGO B
:NCEXE
  27 W "[1;32m"
:NCGO
  SAFEPUTS C 27 W "[0m" R

:SAFEPUTS                  # (a --)  like PUTS, but control bytes show as ? on a terminal
  3248 F PUTS J
  D 3301 T
:SPSCAN
  D F D SPLAST J
  D 32 L SWAP 127 E O SPCTL *
  + SPSCAN B
:SPLAST
  ! 3301 F S 3301 F SWAP WRITEN C R
:SPCTL
  D 3301 F S 3301 F SWAP WRITEN C 63 W + D 3301 T SPSCAN B

# errors:  "cmd: 'path': message"  on stderr
:EPRE
  ERRB C 3302 F PUTS C ": " R
:EEND
  CR ERRE C 1 3303 T R
:PERR                      # (errno --)
  4129 T 2718 4130 T 64 4131 T 19 SYS C ! 2718 PUTS C R
:EFAIL                     # (path errno --)
  3304 T 3305 T
  EPRE C "'" 3305 F PUTS C "': " 3304 F PERR C EEND C R
:MISSING
  EPRE C "missing operand (try: help)" EEND C R

:CLRSTK
  , CLRMORE *
  R
:CLRMORE
  ! CLRSTK B

# =====================================================================
#  line reader (UTF-8 encodes non-ASCII input) and tokenizer
# =====================================================================

:PUTLB                     # (b --)
  3306 F 255 / PLFULL *
  3306 F 0 A T
  3306 PSTO R
:PLFULL
  ! 1 3307 T R

:UTF8                      # (c --)  c >= 128
  D 2048 L U8TWO *
  D 65536 L U8THREE *
  D 18 > 240 O PUTLB C
  D 12 > 63 P 128 O PUTLB C
  D 6 > 63 P 128 O PUTLB C
  63 P 128 O PUTLB C R
:U8THREE
  D 12 > 224 O PUTLB C
  D 6 > 63 P 128 O PUTLB C
  63 P 128 O PUTLB C R
:U8TWO
  D 6 > 192 O PUTLB C
  63 P 128 O PUTLB C R

:READLINE                  # ( -- eof )
  0 3306 T 0 3307 T
:RLLP
  ?
  D 0 L RLEOF *
  D 10 E RLEOL *
  D 13 E RLSKIP *
  D RLSKIP J
  D 128 L RLASC *
  UTF8 C RLLP B
:RLASC
  PUTLB C RLLP B
:RLSKIP
  ! RLLP B
:RLEOL
  ! RLFIN B
:RLEOF
  !
  3306 F RLFIN *
  0 0 T 1 R
:RLFIN
  0 3306 F 0 A T
  3307 F RLWARN *
  0 R
:RLWARN
  ERRB C "sak: line cut to 255 bytes" CR ERRE C 0 R

:LCH                       # ( -- c )
  3308 F 0 A F R

:TOKENIZE                  # LINE -> ARGV/$argc, handles quotes, \x and > >> redirection
  0 3308 T 0 3309 T 0 3310 T
:TKNEXT
  LCH C
  D 32 E TKWS *
  D 9 E TKWS *
  D TKDONE J
  !
  3310 F 31 / TKFIN *
  3309 F 256 A 3310 F 544 A T
  3310 PSTO 0 3311 T
:TKCH
  LCH C
  D TKEND J
  3311 F TKINQ *
  D 32 E TKEND *
  D 9 E TKEND *
  D 34 E TKQOPEN *
  D 39 E TKQOPEN *
  D 92 E TKBSL *
  D 62 E TKGT *
  TKPUT C
:TKADV
  3308 PSTO TKCH B
:TKWS
  ! 3308 PSTO TKNEXT B
:TKDONE
  ! TKFIN B
:TKEND
  ! 0 TKPUT C TKNEXT B
:TKQOPEN
  3311 T 3308 PSTO TKCH B
:TKINQ
  D 3311 F E TKQCLOSE *
  TKPUT C TKADV B
:TKQCLOSE
  ! 0 3311 T TKADV B
:TKBSL
  ! 3308 PSTO LCH C D TKEND J
  TKPUT C TKADV B
:TKGT                      # unquoted > inside a word: split it off as its own word
  !
  3310 F - 544 A F 3309 F 256 A E TKGTSAME *
  0 TKPUT C
  3310 F 31 / TKFIN *
  3309 F 256 A 3310 F 544 A T 3310 PSTO
:TKGTSAME
  62 TKPUT C 3308 PSTO
  LCH C 62 = TKGTEND *
  62 TKPUT C 3308 PSTO
:TKGTEND
  0 TKPUT C TKNEXT B
:TKPUT                     # (c --)  the last ARGBUF cell is never written: always a NUL
  3309 F 287 / TKPFULL *
  3309 F 256 A T 3309 PSTO R
:TKPFULL
  ! R
:TKFIN
  0 3312 T 0 3313 T
:RDLP
  3313 F 3310 F / RDDONE *
  3313 F 544 A F
  D F 62 = RDNX *
  + D F 62 E RDAPP *
  1 3312 T RDTGT B
:RDAPP
  + 2 3312 T
:RDTGT
  D F RDHAVE *
  ! 3313 F + D 3310 F L RDNOTGT J
  544 A F
:RDHAVE
  3314 T
  3313 F 3310 T
  RDDONE B
:RDNX
  ! 3313 PSTO RDLP B
:RDNOTGT
  ! ERRB C "sak: missing file name after >" CR ERRE C
  0 3312 T 0 3310 T
:RDDONE
  R


:OBFLUSH                   # the genetic-code tables print through this; here it has nothing to flush
  R

# =====================================================================
#  the genetic code (shared with paint.aa)
# =====================================================================
# ---- generated by gen_codons.py: the standard genetic code (NCBI table 1) ----

:AATAB                     # (codon*2 + AATAB) -> amino acid index, A C D E ... Y, 20 = stop
  8 R                      # AAA K
  11 R                      # AAC N
  8 R                      # AAG K
  11 R                      # AAT N
  16 R                      # ACA T
  16 R                      # ACC T
  16 R                      # ACG T
  16 R                      # ACT T
  14 R                      # AGA R
  15 R                      # AGC S
  14 R                      # AGG R
  15 R                      # AGT S
  7 R                      # ATA I
  7 R                      # ATC I
  10 R                      # ATG M
  7 R                      # ATT I
  13 R                      # CAA Q
  6 R                      # CAC H
  13 R                      # CAG Q
  6 R                      # CAT H
  12 R                      # CCA P
  12 R                      # CCC P
  12 R                      # CCG P
  12 R                      # CCT P
  14 R                      # CGA R
  14 R                      # CGC R
  14 R                      # CGG R
  14 R                      # CGT R
  9 R                      # CTA L
  9 R                      # CTC L
  9 R                      # CTG L
  9 R                      # CTT L
  3 R                      # GAA E
  2 R                      # GAC D
  3 R                      # GAG E
  2 R                      # GAT D
  0 R                      # GCA A
  0 R                      # GCC A
  0 R                      # GCG A
  0 R                      # GCT A
  5 R                      # GGA G
  5 R                      # GGC G
  5 R                      # GGG G
  5 R                      # GGT G
  17 R                      # GTA V
  17 R                      # GTC V
  17 R                      # GTG V
  17 R                      # GTT V
  20 R                      # TAA *
  19 R                      # TAC Y
  20 R                      # TAG *
  19 R                      # TAT Y
  15 R                      # TCA S
  15 R                      # TCC S
  15 R                      # TCG S
  15 R                      # TCT S
  20 R                      # TGA *
  1 R                      # TGC C
  18 R                      # TGG W
  1 R                      # TGT C
  9 R                      # TTA L
  4 R                      # TTC F
  9 R                      # TTG L
  4 R                      # TTT F

