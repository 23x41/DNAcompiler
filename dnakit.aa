# =====================================================================
#  dis: codons as GATC instructions, the way the loader runs a gene
# =====================================================================
:C_DIS
  FILEARG C DSRET J
  PROBE C
  2 1 NARG C 1 MAX 3380 T
  3 48 NARG C 1 MAX 3381 T
  3380 F 3332 F G VWPAST *
  3380 F - BOFF C ISEEK C
  3380 F 3382 T 0 3383 T 0 3384 T
  BOLDON C "      base  colour codon  instruction    amino acid" RST C CR
:DSLP
  3383 F 3381 F / DSEND *
  DSCODON C DSENDX J 3385 T
  3382 F 10 PADNC C "  " 3385 F SWATCH C "  " 3385 F CODONOUT C "  "
  3384 F DSIMM *
  3385 F OPNAME C 13 3315 F S SPACES C
  3385 F 0 E DSLITON *
  DSAA B
:DSLITON
  1 3384 T DSAA B
:DSIMM                     # the codon after LIT is its number, 0..63
  0 3384 T DIM C "= " 3385 F Y 3385 F 10 L DSIMM1 *
  "         " DSAA B
:DSIMM1
  "          "
:DSAA
  RST C 3385 F AAOF C D 20 E DSSTOP *
  D AA3 C " " 3681 A F W DSNOTE B
:DSSTOP
  ! 203 FGX C "stop" RST C
:DSNOTE
  3382 F 1 E 3385 F 14 E P DSSTART *
  CR 3382 F 3 A 3382 T 3383 PSTO DSLP B
:DSSTART
  DIM C "   start codon: skipped by the loader" RST C CR
  3382 F 3 A 3382 T 3383 PSTO DSLP B
:DSCODON                   # ( -- codon ok )  next three bases, N read as A
  0 3
:DSCLP
  D DSCOK J
  NB C D 0 L DSCEOF *
  D 4 E DSCN *
  ROT 4 M A SWAP - DSCLP B
:DSCN
  ! 0 ROT 4 M A SWAP - DSCLP B
:DSCOK
  ! 1 R
:DSCEOF
  ] ! 0 0 R
:DSENDX
  !
:DSEND
  CLOSEIN C
  DIM C "LIT reads the next codon as a number (0-63). Packed .dna files from 'compile --dna'" RST C CR
  DIM C "store bytes 4 bases each, so read those with GATCnux.py disasm instead." RST C CR
:DSRET
  R

