:AAOF                      # (codon -- amino acid index, 20 = stop)
  2 M AATAB A C R

# =====================================================================
#  colours: the same 64 codon colours as paint.aa (xterm-256)
# =====================================================================
:LV                        # (0..3 -- 0 1 3 5)
  D 2 / LVHI *
  R
:LVHI
  D A - R
:XTC                       # (codon -- xterm colour number)
  D 4 > LV C 36 M OVER 2 > 3 P LV C 6 M A SWAP 3 P LV C A 16 A R
:FGX                       # (xterm --)
  3248 F FGNO J
  27 W "[38;5;" Y "m" R
:FGNO
  ! R
:BGX
  3248 F FGNO J
  27 W "[48;5;" Y "m" R
:RST
  3248 F RSTNO J
  27 W "[0m"
:RSTNO
  R
:BOLDON
  3248 F RSTNO J
  27 W "[1m" R
:DIM
  3248 F RSTNO J
  27 W "[38;5;245m" R
:BASEFG                    # (class 0..4 --)  A blue  C amber  G green  T coral  N grey
  D BFA J
  D 1 E BFC *
  D 2 E BFG *
  D 3 E BFT *
  ! 245 FGX C R
:BFA
  ! 63 FGX C R
:BFC
  ! 214 FGX C R
:BFG
  ! 83 FGX C R
:BFT
  ! 203 FGX C R
:CODONOUT                  # (codon --)  three bases, each in its colour
  D 4 > D BASEFG C 3676 A F W
  D 2 > 3 P D BASEFG C 3676 A F W
  3 P D BASEFG C 3676 A F W RST C R
:SWATCH                    # (codon --)  a block of the codon's own colour
  3248 F SWNO J
  XTC C BGX C "   " RST C R
:SWNO
  ! "[" "]" " " R
:OPNAME                    # (codon --)  the VM instruction this codon encodes; $onl = its length
  0 3315 T 3395 SWAP
:ONLP
  D ONGO J
  SWAP
:ONSKIP
  D F 32 = ONNEXT1 *
  + SWAP - ONLP B
:ONNEXT1
  + ONSKIP B
:ONGO
  !
:ONPR
  D F D 32 = OVER BOOL P ONPC *
  ] R
:ONPC
  W 3315 PSTO + ONPR B
# =====================================================================
#  numbers
# =====================================================================
:NC                        # (n --)  with thousands commas
  D 1000 L NCS *
  D 1000 V NC C
  44 W 1000 MOD
  D 100 V Y D 10 V 10 MOD Y 10 MOD Y R
:NCS
  Y R
:NCW                       # (n -- width)  printed width of NC
  NUMW C D - 3 V A R
:PADNC                     # (n width --)  right aligned with commas
  OVER NCW C S SPACES C NC C R
:PCT1                      # (part whole --)  one decimal, e.g. 47.3%
  D PCZ J
  SWAP 2000 M OVER V + 2 V NIP
  D 10 V Y 46 W 10 MOD Y 37 W R
:PCZ
  ] "-" R

# =====================================================================
#  reading FASTA
#  NB: next sequence character, header lines and line breaks skipped.
#  class 0 A  1 C  2 G  3 T/U  4 other letter (N, IUPAC)  -1 end of file
# =====================================================================
:TABLES
  0 3316 T
:TBH                       # bytes 128..255: not sequence
  3316 F 256 / TBH2 *
  9 3316 F 2782 A T 3316 PSTO TBH B
:TBH2
  0 3316 T
:TBLP
  3316 F 128 / TBEND *
  9 3316 F 2782 A T
  0 3316 F 3038 A T
  3316 F 32 O 97 L TBN *
  3316 F 32 O 122 G TBN *
  4 3316 F 2782 A T 3316 F 3316 F 3038 A T
:TBN
  3316 PSTO TBLP B
:TBEND
  4 45 2782 A T 45 45 3038 A T 4 42 2782 A T 5 62 2782 A T 7 2782 T
  0 65 2782 A T 1 67 2782 A T 2 71 2782 A T 3 84 2782 A T 3 85 2782 A T
  0 97 2782 A T 1 99 2782 A T 2 103 2782 A T 3 116 2782 A T 3 117 2782 A T
  CTPAIRS C 42 42 3038 A T
  0 3316 T
:CCLP                      # codon classes for the ORF finder
  3316 F 64 / CCEND *
  0 3316 F 3166 A T 3316 PSTO CCLP B
:CCEND
  1 14 3166 A T             # ATG start
  2 48 3166 A T 2 50 3166 A T 2 56 3166 A T     # TAA TAG TGA stop
  3 19 3166 A T             # CAT  = ATG on the other strand
  4 60 3166 A T 4 28 3166 A T 4 52 3166 A T     # TTA CTA TCA = stops on the other strand
  R
:CTPAIRS                   # complement pairs (upper and lower case): A-T G-C R-Y K-M B-V D-H, U -> A
  65 84 CTP C 71 67 CTP C 82 89 CTP C 75 77 CTP C 66 86 CTP C 68 72 CTP C
  65 85 3038 A T 97 117 3038 A T R
:CTP                       # (x y --)  x <-> y, both cases
  OVER OVER SWAP 3038 A T OVER OVER 3038 A T
  32 O SWAP 32 O OVER OVER SWAP 3038 A T 3038 A T R

:OPENIN                    # PA -> $ifd ( -- ok )
  576 1 STATP C OIERR J
  3245 F 2 E OIDIR *
  3244 F 3317 T
  576 0 FOPEN C OIERR J
  4134 F 3318 T 0 3319 T 0 3320 T 0 3321 T 1 R
:OIERR
  576 4134 F EFAIL C 0 R
:OIDIR
  EPRE C "'" 576 PUTS C "': Is a directory" EEND C 0 R
:CLOSEIN
  3318 F FCLOSE C R
:ISEEK                     # (byte offset --)  empty buffer: the 0 at BLK makes NB refill
  D 3322 T 3318 F SWAP FSEEK C 1432 3319 T 1432 3320 T 0 1432 T R
:REFILL                    # ( -- ok )  a 0 byte after the data marks the end of the buffer
  3318 F 4129 T 1432 4130 T 512 4131 T 10 SYS C RFNO J
  4134 F D RFNO0 J 1432 A D 3320 T 0 SWAP T 1432 3319 T 1 R
:RFNO0
  !
:RFNO
  0 R
:NB                        # ( -- class | -1 )   the byte read is at $bp - 1
  3319 F F 3319 PSTO 2782 A F
  D 5 L NBRET *
  D 7 E NBZERO *
  5 = NB *
  3321 PSTO
:NBHL
  3319 F 3320 F L NBHL2 *
  REFILL C NBEOF J
:NBHL2
  3319 F F 3319 PSTO 10 = NBHL *
  NB B
:NBRET
  R
:NBZERO                    # a 0 byte: the end of the buffer (refill), or a stray 0 in the file
  ! 3319 F - 3320 F = NB *
  REFILL C NBEOF J
  NB B
:NBEOF
  0 1 S R
:RB                        # ( -- byte | -1 )  raw bytes, counting $rpos
  3319 F 3320 F L RBHAVE *
  REFILL C NBEOF J
:RBHAVE
  3319 F F 3319 PSTO 3322 PSTO R

# backwards byte reader: BSEEK(end offset), BB returns bytes below it, down to $blim
:BSEEK
  3323 T 0 3324 T R
:BB                        # ( -- byte | -1 )
  3324 F BBFILL J
:BBHAVE
  3324 F - D 3324 T 1432 A F R
:BBFILL
  3323 F 3325 F ^ NBEOF *
  3323 F 3325 F S 512 MIN 3326 T
  3323 F 3326 F S 3323 T
  3318 F 3323 F FSEEK C
  3318 F 4129 T 1432 4130 T 3326 F 4131 T 10 SYS C NBEOF J
  4134 F D BBZ J 3324 T BBHAVE B
:BBZ
  ! NBEOF B

# PROBE: standard FASTA = one header line, then lines of equal width, so base b
# sits at byte  header + b + (b / width) * line-end.  Sets $vh $vw $ve and $vn (bases).
:PROBE
  0 ISEEK C
  RB C 62 = PBNOH *
:PBHDR
  RB C D 0 L PBHEND *
  10 = PBHDR *
  PBHD2 B
:PBHEND
  !
:PBHD2
  3322 F 3327 T PBW B
:PBNOH
  0 3327 T 0 ISEEK C
:PBW
  0 3328 T 1 3329 T
:PBWL
  RB C
  D 0 L PBWEND *
  D 10 E PBWEND *
  D 13 E PBCR *
  ! 3328 PSTO PBWL B
:PBCR
  ! 2 3329 T PBWD B
:PBWEND
  !
:PBWD
  3328 F 1 MAX 3328 T
  0 3330 T
  3317 F 1 L PBCOUNT *
  3317 F - ISEEK C RB C 10 = PBCOUNT *
  3329 F 3330 T
:PBCOUNT
  3317 F 3327 F S 3330 F S 0 MAX 3331 T
  3331 F 3331 F 3328 F 3329 F A V 3329 F M S 3332 T R
:BOFF                      # (base index -- byte offset)
  D 3328 F V 3329 F M A 3327 F A R

:HEADER                    # first header line (without '>') -> LBUF, "" if none
  0 2508 T 0 ISEEK C
  RB C 62 = HDRET *
  0 3333 T
:HDLP
  RB C D 0 L HDEND *
  D 10 E HDEND *
  D 13 E HDEND *
  3333 F 200 / HDSKIP *
  3333 F 2508 A T 3333 PSTO HDLP B
:HDSKIP
  ! HDLP B
:HDEND
  ! 0 3333 F 2508 A T
:HDRET
  R

# =====================================================================
#  arguments
# =====================================================================
:FILEARG                   # ( -- ok )  argv[1] -> PA, opened, probed
  3310 F 2 L FAUSE *
  1 544 A F 576 600 STRNCPY C
  OPENIN C R
:FAUSE
  EPRE C "needs a file (try: help)" EEND C 0 R
:NARG                      # (index default -- n)  a number argument, or the default
  SWAP D 3310 F / NADEF *
  NIP 544 A F D F 45 E NANEG *
  PARSENUM C 3270 F NABAD * R
:NADEF
  ! R
:NANEG
  ! 0 R
:NABAD
  ! EPRE C "that is not a number" EEND C 0 R
:STRANDARG                 # (index -- minus?)  "-" means the reverse strand
  D 3310 F / SADEF *
  544 A F F 45 E R
:SADEF
  ! 0 R

# =====================================================================
#  info
# =====================================================================
:C_INFO
  FILEARG C INRET J
  HEADER C PROBE C
  0 ISEEK C 0 3321 T
  0 3239 T 0 3239 + T 0 3239 2 A T 0 3239 3 A T 0 3239 4 A T
  3317 F 2000000 G INSLOW J
  DIM C "(reading " 3317 F NC C " bytes...)" RST C CR
:INSLOW
:INLP
  NB C D 0 L INEND *
  3239 A PSTO INLP B
:INEND
  ! CLOSEIN C
  3239 F 3239 + F A 3239 2 A F A 3239 3 A F A 3334 T
  3334 F 3239 4 A F A 3335 T
  BOLDON C 576 PUTS C RST C CR
  2508 F INNOH J
  DIM C "  header    " RST C 2508 PUTS C CR
:INNOH
  DIM C "  records   " RST C 3321 F 1 MAX NC C CR
  DIM C "  length    " RST C 3335 F NC C " bases" CR
  "  " 0 BASEFG C "A" RST C DIM C "         " RST C 3239 F 12 PADNC C "   " 3239 F 3334 F PCT1 C CR
  "  " 1 BASEFG C "C" RST C DIM C "         " RST C 3239 + F 12 PADNC C "   " 3239 + F 3334 F PCT1 C CR
  "  " 2 BASEFG C "G" RST C DIM C "         " RST C 3239 2 A F 12 PADNC C "   " 3239 2 A F 3334 F PCT1 C CR
  "  " 3 BASEFG C "T" RST C DIM C "         " RST C 3239 3 A F 12 PADNC C "   " 3239 3 A F 3334 F PCT1 C CR
  "  " 4 BASEFG C "N/other" RST C DIM C "   " RST C 3239 4 A F 12 PADNC C CR
  DIM C "  GC        " RST C BOLDON C 3239 + F 3239 2 A F A 3334 F PCT1 C RST C
  DIM C "   (of A+C+G+T)" RST C CR
  DIM C "  GC skew   " RST C
  3239 2 A F 3239 + F S 3336 T 3239 2 A F 3239 + F A 3337 T
  3337 F INSK0 J
  3336 F 0 L INSKN *
  43 W INSKP B
:INSKN
  45 W 3336 F ~ 3336 T
:INSKP
  3336 F 1000 M 3337 F V
  D 1000 V Y 46 W 1000 MOD D 100 L INSP1 * Y INSKD B
:INSP1
  48 W D 10 L INSP2 * Y INSKD B
:INSP2
  48 W Y
:INSKD
  DIM C "   (G-C)/(G+C)" RST C CR
  3321 F 1 G INRET *
  DIM C "  layout    " RST C 3328 F NC C " bases per line" CR
:INRET
  R
:INSK0
  "-" CR R

# =====================================================================
#  view
# =====================================================================
:C_VIEW
  FILEARG C VWRET J
  PROBE C
  2 1 NARG C 1 MAX 3338 T
  3 600 NARG C 1 MAX 3339 T
  3338 F 3332 F G VWPAST *
  3338 F - BOFF C ISEEK C
  0 3340 T 99 3341 T
:VWLP
  3340 F 3339 F / VWEND *
  NB C D 0 L VWEND0 *
  3340 F 60 MOD VWNOROW *
  3340 F VWFIRST J
  RST C CR 99 3341 T
:VWFIRST
  DIM C 3338 F 3340 F A 11 PADNC C "  " RST C 99 3341 T VWCH B
:VWNOROW
  3340 F 10 MOD VWCH *
  32 W
:VWCH
  D 3341 F E VWSAME *
  D 3341 T D BASEFG C
:VWSAME
  ! 3319 F - F W
  3340 PSTO VWLP B
:VWEND0
  !
:VWEND
  RST C CR CLOSEIN C
  DIM C "bases " 3338 F NC C "-" 3338 F 3340 F A - NC C " of " 3332 F NC C RST C CR R
:VWPAST
  CLOSEIN C EPRE C "start is past the end (" 3332 F NC C " bases)" EEND C
:VWRET
  R

# =====================================================================
#  gc: GC% in windows, drawn as bars
# =====================================================================
:C_GC
  FILEARG C GCRET J
  PROBE C
  2 0 NARG C 3342 T
  3342 F GCHAVE *
  3332 F 29 A 30 V 100 MAX 3342 T
:GCHAVE
  3342 F 10 MAX 3342 T
  0 ISEEK C
  BOLDON C 576 PUTS C RST C DIM C "   window " 3342 F NC C " bases" RST C CR
  0 3343 T 0 3344 T 0 3345 T 0 3346 T 0 3347 T 0 3348 T 1001 3349 T 0 3350 T
:GCLP
  NB C D 0 L GCEND *
  D 1 E OVER 2 E O 3345 MADD
  D 4 L 3346 MADD
  ! 3344 PSTO 3343 PSTO
  3344 F 3342 F L GCLP *
  GCBAR C GCLP B
:GCEND
  ! 3344 F GCDONE J
  GCBAR C
:GCDONE
  CLOSEIN C
  DIM C "  overall GC " RST C BOLDON C 3347 F 3348 F PCT1 C RST C
  3350 F GCRET J
  DIM C "   lowest window " RST C 3349 F 10 V Y 46 W 3349 F 10 MOD Y 37 W
  DIM C "   highest " RST C 3350 F 10 V Y 46 W 3350 F 10 MOD Y 37 W
:GCRET
  CR R
:GCBAR                     # one window: range, GC%, a bar of 0..50 blocks
  24 3343 F 3344 F S + NCW C S 3343 F NCW C S SPACES C
  3343 F 3344 F S + NC C DIM C "-" RST C 3343 F NC C "   "
  3345 F 3347 MADD 3346 F 3348 MADD
  3346 F GCBNONE J
  3345 F 1000 M 3346 F V 3351 T
  3351 F 3349 F MIN 3349 T 3351 F 3350 F MAX 3350 T
  3351 F 10 V 3 PADNUM C 46 W 3351 F 10 MOD Y "%  "
  3351 F 350 L GCB1 *
  3351 F 450 L GCB2 *
  3351 F 550 L GCB3 *
  3351 F 650 L GCB4 *
  203 GCBGO B
:GCB1
  39 GCBGO B
:GCB2
  83 GCBGO B
:GCB3
  227 GCBGO B
:GCB4
  214
:GCBGO
  FGX C 3721 3351 F 10 A 20 V 3 M WRITEN C RST C
:GCBNEXT
  CR 0 3344 T 0 3345 T 0 3346 T R
:GCBNONE
  "   no A/C/G/T here" GCBNEXT B

# =====================================================================
#  revcomp: reads the file backwards, complements every base
# =====================================================================
:OBC                       # (byte --)  buffered output to $ofd
  3352 F T 3352 PSTO
  3352 F 1952 S 280 L OBCR *
  OBOUT C
:OBCR
  R
:OBOUT
  3352 F 1952 S D OBOZ J
  3353 F 4129 T 1952 4130 T 4131 T 11 SYS C !
  1952 3352 T R
:OBOZ
  ! R
:OBS                       # (addr --)
  D F OBSE J
  D F OBC C + OBS B
:OBSE
  ! R

:C_REVCOMP
  FILEARG C RCRET J
  PROBE C HEADER C
  1 3353 T 0 3354 T
  3310 F 3 L RCSTD *
  2 544 A F 1176 256 STRNCPY C
  576 1176 SAMEF C RCSAME *
  1176 1 FOPEN C RCOFAIL J
  4134 F 3353 T 1 3354 T
:RCSTD
  1952 3352 T
  62 OBC C
  2508 F RCNOH J
  2508 OBS C RCHD2 B
:RCNOH
  576 OBS C
:RCHD2
   3872  OBS C 10 OBC C
  3317 F BSEEK C 3327 F 3325 T
  0 3355 T 0 3356 T 0 3357 T
:RCLP
  BB C D 0 L RCEND *
  D 62 E RCMULTI *
  127 P 3038 A F D RCSKIP J
  OBC C 3356 PSTO 3355 PSTO
  3355 F 60 L RCLP *
  10 OBC C 0 3355 T RCLP B
:RCSKIP
  ! RCLP B
:RCMULTI
  1 3357 T
:RCEND
  !
  3355 F RCNOEOL J
  10 OBC C
:RCNOEOL
  OBOUT C CLOSEIN C
  3354 F RCMSG J
  3353 F FCLOSE C
  DIM C "wrote " 3356 F NC C " bases to " 1176 PUTS C RST C CR
:RCMSG
  3357 F RCRET J
  EPRE C "this file has more than one record: revcomp reads single-record FASTA" EEND C
:RCRET
  R
:RCSAME
  CLOSEIN C EPRE C "the output must be a different file" EEND C R
:RCOFAIL
  CLOSEIN C 1176 4134 F EFAIL C R

# =====================================================================
#  orf: one pass, all six frames.
#  The codon ending at each base belongs to frame (pos-2) mod 3.
#  + strand: ATG opens an ORF in its frame, the next stop in frame closes it.
#  - strand: CAT (ATG read backwards) after a TTA/CTA/TCA stop starts an ORF
#  that runs back to that stop; the last CAT before the next stop gives the longest.
# =====================================================================
:C_ORF
  FILEARG C ORRET J
  2 100 NARG C 1 MAX 3358 T
  0 ISEEK C
  0 3230 T 0 3230 + T 0 3230 2 A T 0 3233 T 0 3233 + T 0 3233 2 A T 0 3236 T 0 3236 + T 0 3236 2 A T
