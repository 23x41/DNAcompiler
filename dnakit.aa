# =====================================================================
#  help, main loop
# =====================================================================
:C_HELP
  BOLDON C 214 FGX C "GATC DNA toolkit" RST C DIM C " - every tool is GATC assembly" RST C CR CR
  "  info FILE                    records, length, base counts, GC% and GC skew" CR
  "  view FILE [START] [LEN]      coloured bases, numbered rows of 60" CR
  "  gc FILE [WINDOW]             GC% along the sequence as bars" CR
  "  revcomp FILE [OUT]           reverse complement as FASTA (IUPAC aware)" CR
  "  orf FILE [MINAA]             open reading frames ATG..stop, six frames (default 100 aa)" CR
  "  translate FILE START END [-] protein of a region; - = reverse strand" CR
  "  dis FILE [START] [COUNT]     codons as VM instructions, in paint's colours" CR
  "  codon ACG                    one codon: colour, instruction, amino acid" CR
  "  ls [DIR]  cd [DIR]  pwd  clear  help  exit      redirect: > file  >> file" CR CR
  DIM C "Positions are 1-based. view, translate and dis jump straight to a position, which" RST C CR
  DIM C "assumes the usual FASTA layout (one header, equal line widths). ORF frames are" RST C CR
  DIM C "counted from the start of the + strand for both strands." RST C CR R

:C_CLEAR
  27 W "[H" 27 W "[2J" R
:C_EXIT
