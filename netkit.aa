  108 1435 T
  112 1436 T
  0 1437 T
  4120 F 20037 = NONET *
  "GATC NETKIT - network swiss army knife" CR
  CHELP C
  LOOP B

:NONET
  "network support is off: use the netkit GATCloader.py and add --net" CR
  H

:LOOP
  CLRSTK C
:PROMPT
  "netkit> "
  READLINE C QUITEOF *
  SKIPWS C
  PEEKC C 32 G DISP *
  PROMPT B
:DISP
  1450 GETTOK C !
  1157 F UNKNOWN *
  LOWERW C
  HAVEARG C 1165 T
  1450 F 1179 T
  1450 1 A F 1180 T
  1180 F NOTNUM *
  1179 F 49 E TPING *
  1179 F 50 E TDIG *
  1179 F 51 E TWHOIS *
  1179 F 52 E TNC *
  1179 F 53 E TLISTEN *
  1179 F 54 E THTTP *
  1179 F 55 E TTCP *
  1179 F 56 E TRESOLVE *
  1179 F 57 E TREV *
  1179 F 48 E BYE *
  1179 F 63 E CHELP *
:NOTNUM
  1276 MATCH C CHELP *
  1336 MATCH C CHELP *
  1216 MATCH C TPING *
  1228 MATCH C TDIG *
  1240 MATCH C TWHOIS *
  1252 MATCH C TNC *
  1264 MATCH C TLISTEN *
  1288 MATCH C THTTP *
  1300 MATCH C TTCP *
  1312 MATCH C TRESOLVE *
  1324 MATCH C TREV *
  1348 MATCH C BYE *
  1360 MATCH C BYE *
:UNKNOWN
  "unknown tool - ? for the menu" CR
  LOOP B

:BYE
  "bye" CR
  H

:QUITEOF
  CR
  H
