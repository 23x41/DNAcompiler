  4153 F 18516 E TTYOK *
  4153 F 1 E TTYOFF *
  "paint.aa needs GATCnux.py (version 4.3 or later) for keyboard and screen access." CR 1 Q
:TTYOFF
  "paint.aa needs the terminal bridge. Run it with --tty (and --fs to save):" CR
  "  python3 GATCnux.py run paint.aa --no-banner --tty --fs --max-steps 2000000000" CR 1 Q
:TTYOK
  1200 3040 T
  XTINIT C BTINIT C
  56 3069 T 1 3072 T 30 3066 T 20 3060 T 99 3052 T
  1 4145 T 1 TSYS C !
  ESC C  4003  OBS C ESC C  4010  OBS C ESC C  4014  OBS C ESC C  4019  OBS C ESC C  4026  OBS C
  FULLDRAW C
  MSG C OBFLUSH C "hello! type three bases (try G C A) to pick a colour, arrows + space to paint"
  OBFLUSH C
:LOOP
  3145 F STASHED *
  0 4145 T 2 TSYS C GOTKEY *
  4149 F 1 E QUITNOW *
  LOOP B
:STASHED                   # a key read while merging mouse drags
  0 3145 T 3146 F 3143 T 3147 F 3151 T 3148 F 3152 T 3149 F 3161 T GOTK2 B
:GOTKEY
  4149 F 3143 T 4150 F 3151 T 4151 F 3152 T 4152 F 3161 T
:GOTK2
  3143 F 2000 = GOTK3 *
  3161 F 32 P GOTK3 J
:MERGE                     # skip drag reports that are already waiting: draw to the newest
  1 4145 T 2 TSYS C GOTK3 J
  4149 F 2000 E 4152 F 32 P BOOL P MERGE1 *
  1 3145 T 4149 F 3146 T 4150 F 3147 T 4151 F 3148 T 4152 F 3149 T GOTK3 B
:MERGE1
  4150 F 3151 T 4151 F 3152 T 4152 F 3161 T MERGE B
:GOTK3
  0 3162 T
  KEYS C
  FLUSHDIRTY C PANEL C OBFLUSH C
  3163 F QUITNOW *
  LOOP B
:QUITNOW
  RESET C ESC C  4033  OBS C ESC C  4040  OBS C ESC C  4047  OBS C ESC C  4052  OBS C ESC C  4056  OBS C
  OBFLUSH C 0 4145 T 1 TSYS C !
  "bye from GATC PAINT" CR H

