# =====================================================================
# paint.aa  --  GATC PAINT: a 64-colour pixel painter for the GATC VM
#
#   python3 GATCnux.py run paint.aa --no-banner --tty --fs --max-steps 2000000000
#
# 64 codons = 64 colours.  A codon's three bases are its red, green and blue
# levels (A 0, C 85, G 170, T 255), so the colour number is the codon's own
# 6-bit value - and every colour is also one of the VM's 64 instructions.
# Type three bases (e.g. G C A) to pick a colour.
#
# Pictures are saved as a FASTA DNA sequence (one codon per pixel) that can be
# loaded again, plus a BMP image (480x320) that any viewer opens.
#
# --tty (GATCnux.py) gives raw keys, the mouse and fast screen writes;
# --fs is only needed for saving and loading.  Everything else - the canvas,
# drawing, lines, circles, flood fill, mirrors, maths patterns, FASTA and BMP
# encoding - is GATC assembly.
#
# Generated from paint.tpl by gen_aa.py.  No negative literals (DNA-safe).
# Memory map (generated):
#       0..  599  CANVAS
#     600.. 1199  UNDO
#    1200.. 1967  OB
#    1968.. 2687  FSTACK
#    2688.. 2735  NB
#    2736.. 2799  PATH
#    2800.. 2863  XT
#    2864.. 2911  VNAME
#    2912.. 3039  BT
#    3040.. 3172  variables (133)
#    3173.. 4078  strings (91)   free: 17 cells
# =====================================================================





MAIN B

# =====================================================================
#  bridges
# =====================================================================
:TSYS                      # (cmd -- status)
  4144 T 4148 F R
:FSYS                      # (cmd -- status)
  4128 T 4133 F R

# =====================================================================
#  output buffer: everything on screen goes through OB, one write per frame
#  ($obfd = 0: the terminal, else a file handle from the fs bridge)
# =====================================================================
:OBC                       # (byte --)  no bounds check: callers use OBROOM
  3040 F T 3040 PSTO R
:OBROOM                    # make sure there is room for ~60 more bytes
  3040 F 1200 S 700 L OBRR *
  OBFLUSH B
:OBRR
  R
:OBFLUSH
  3040 F 1200 S D OBFZ J
  3041 F OBFILE *
  1200 4145 T 4146 T 3 TSYS C !
  1200 3040 T R
:OBFILE
  1200 4130 T 4131 T 3041 F 4129 T 11 FSYS C !
  1200 3040 T R
:OBFZ
  ! R
:OBS                       # (addr --)  append a NUL-terminated string
  OBROOM C
:OBSLP
  D F OBSEND J
  D F OBC C + OBSLP B
:OBSEND
  ! R
:OBN                       # (n --)  decimal
  D 10 L OBN1 *
  D 10 V OBN C
  10 MOD
:OBN1
  48 A OBC C R
:OBSP                      # (k --)  k spaces
  D 1 L OBSPE *
  32 OBC C - OBSP B
:OBSPE
  ! R
:ESC                       # ESC [
  27 OBC C 91 OBC C R
:GOTO                      # (row col --)
  SWAP ESC C OBN C 59 OBC C OBN C 72 OBC C R
:RESET                     # plain colours
  ESC C 48 OBC C 109 OBC C 999 3042 T 999 3043 T R
:TG                        # (row col --)  move there with plain colours
  GOTO C RESET C R
:XTOUT                     # (colour --)  its xterm number, 2 or 3 digits
  2800 A F
  D 100 L XT2 *
  D 100 V 48 A 3040 F T 3040 PSTO
:XT2
  D 10 V 10 MOD 48 A 3040 F T 3040 PSTO 10 MOD 48 A 3040 F T 3040 PSTO R
:FG5                       # "38;5;"
  51 3040 F T 3040 PSTO 56 3040 F T 3040 PSTO 59 3040 F T 3040 PSTO 53 3040 F T 3040 PSTO 59 3040 F T 3040 PSTO R
:BG5                       # "48;5;"
  52 3040 F T 3040 PSTO 56 3040 F T 3040 PSTO 59 3040 F T 3040 PSTO 53 3040 F T 3040 PSTO 59 3040 F T 3040 PSTO R
:SETFG                     # (colour --)  only emitted when it changes
  D 3042 F E SFSAME *
  D 3042 T
  27 3040 F T 3040 PSTO 91 3040 F T 3040 PSTO FG5 C XTOUT C 109 3040 F T 3040 PSTO R
:SFSAME
  ! R
:SETBG
  D 3043 F E SFSAME *
  D 3043 T
  27 3040 F T 3040 PSTO 91 3040 F T 3040 PSTO BG5 C XTOUT C 109 3040 F T 3040 PSTO R
:COLORS                    # (fg bg --)  one escape for whatever changed
  D 3043 F E CLBGSAME *
  OVER 3042 F E CLFGSAME *
  D 3043 T OVER 3042 T
  27 3040 F T 3040 PSTO 91 3040 F T 3040 PSTO SWAP FG5 C XTOUT C 59 3040 F T 3040 PSTO BG5 C XTOUT C 109 3040 F T 3040 PSTO R
:CLFGSAME
  NIP SETBG B
:CLBGSAME
  ! SETFG B
:GREY                      # dim grey text
  ESC C  3522  OBS C 999 3042 T 999 3043 T R
:BOLD
  ESC C  3534  OBS C R

# =====================================================================
#  colours
# =====================================================================
:XTINIT                    # colour -> xterm-256 index (levels 0 95 175 255)
  0 3044 T
:XTLP
  3044 F 64 / XTEND *
  3044 F 4 > LV C 36 M
  3044 F 2 > 3 P LV C 6 M A
  3044 F 3 P LV C A 16 A
  3044 F 2800 A T
  3044 PSTO XTLP B
:XTEND
  R
:LV                        # (0..3 -- 0 1 3 5)
  D 2 / LVHI *
  R
:LVHI
  D A - R

:CONTRAST                  # (colour -- black or white)
  D 4 > 2 M OVER 2 > 3 P 5 M A SWAP 3 P A
  12 / CTBLK *
  63 R
:CTBLK
  0 R

:CODON                     # (colour --)  three base letters, each in its own hue
  3045 T
  3045 F 4 > BASEOUT C
  3045 F 2 > 3 P BASEOUT C
  3045 F 3 P BASEOUT C R
:BASEOUT                   # (base --)
  D BASECOL C SETFG C
  3454 A F OBC C R
:BASECOL                   # (base -- colour)  A blue CCT, C amber TGA, G green CTC, T coral TCC
  D BCA J
  D 1 E BCC *
  D 2 E BCG *
  ! 53 R
:BCA
  ! 23 R
:BCC
  ! 56 R
:BCG
  ! 29 R

:OPNAME                    # (colour --)  the instruction this codon encodes
  3173 SWAP
:ONLP
  D ONGO J
  SWAP
:ONSKIP
  D F 32 = ONNEXT1 *
  + SWAP - ONLP B
:ONNEXT1
  + ONSKIP B
:ONGO
  !
:ONPR
  D F D 32 = OVER BOOL P ONPC *
  ] R
:ONPC
  OBC C + ONPR B

:HEXRGB                    # (colour --)  #RRGGBB
  35 OBC C
  D 4 > HEX85 C D 2 > 3 P HEX85 C 3 P HEX85 C R
:HEX85                     # (level --)  00 55 AA FF
  D HX0 J
  D 1 E HX5 *
  D 2 E HXA *
  !  3537  OBS C R
:HX0
  !  3540  OBS C R
:HX5
  !  3543  OBS C R
:HXA
  !  3546  OBS C R

# =====================================================================
#  canvas: 60 x 40 pixels, 4 pixels (6 bits each) per memory cell
# =====================================================================
:PXADDR                    # (x y -- addr shift)
  60 M A
  D 2 > 0 A
  SWAP 3 P 6 M R
:GETPX                     # (x y -- colour)
  PXADDR C 3046 T F 3046 F > 63 P R
:SETPX                     # (colour x y --)  ignores points outside the canvas
  3047 T 3048 T 3049 T
  3048 F 0 L SPXOUT *
  3048 F 59 G SPXOUT *
  3047 F 0 L SPXOUT *
  3047 F 39 G SPXOUT *
  3047 F 1 > DIRTY C
  3048 F 3047 F PXADDR C 3046 T 3050 T
  3050 F F 63 3046 F < INV P 3049 F 3046 F < O 3050 F T
  1 3051 T
:SPXOUT
  R
:DIRTY                     # (terminal row --)
  D 3052 F MIN 3052 T 3053 F MAX 3053 T R
:ALLDIRTY
  0 3052 T 19 3053 T R

:SNAP                      # copy the canvas to the undo buffer
  0 3044 T
:SNLP
  3044 F 600 / SNEND *
  3044 F 0 A F 3044 F 600 A T 3044 PSTO SNLP B
:SNEND
  R
:UNDOSWAP                  # undo (press again to redo)
  0 3044 T
:USLP
  3044 F 600 / USEND *
  3044 F 0 A F 3044 F 600 A F 3044 F 0 A T 3044 F 600 A T
  3044 PSTO USLP B
:USEND
  ALLDIRTY C 1 3051 T R
:CLEARC                    # (colour --)  fill the whole canvas
  3054 T 0 3044 T
  3054 F 3054 F 6 < O D 12 < O 3054 T
:CCLP
  3044 F 600 / CCEND *
  3054 F 3044 F 0 A T 3044 PSTO CCLP B
:CCEND
  ALLDIRTY C 1 3051 T R

# =====================================================================
#  drawing on the screen
# =====================================================================
:PXI                       # (pixel index -- colour)
  D 2 > 0 A F SWAP 3 P 6 M > 63 P R
:DRAWROW                   # (terminal row 0..19)  two pixel rows as half blocks
  3055 T
  OBROOM C
  3055 F 2 A 2 GOTO C
  3055 F 120 M 3056 T
  3055 F 2 M 3057 T
  0 3058 T 0 3059 T
  3060 F 1 > 3055 F E 3058 T
  3061 F 3062 F 1 > 3055 F E P 3059 T
  0 3063 T
:DRLP
  3063 F 60 / DREND *
  3056 F 3063 F A D D 2 > 0 A F SWAP 3 P 6 M > 63 P 3064 T 60 A D 2 > 0 A F SWAP 3 P 6 M > 63 P 3065 T
  3058 F DRNOC J
  3063 F 3066 F = DRNOC *
  3057 F 3060 F E DRCT *
  3065 F CONTRAST C 3065 T DRNOC B
:DRCT
  3064 F CONTRAST C 3064 T
:DRNOC
  3059 F DRNOA J
  3063 F 3067 F = DRNOA *
  3057 F 3062 F E DRAT *
  3065 F CONTRAST C 3065 T DRNOA B
:DRAT
  3064 F CONTRAST C 3064 T
:DRNOA
  3063 F 7 P DRROOM J
:DRCELL
  3064 F 3065 F E DRSAME *
  3064 F 3065 F COLORS C
  226 3040 F T 3040 PSTO 150 3040 F T 3040 PSTO 128 3040 F T 3040 PSTO
  3063 PSTO DRLP B
:DRSAME
  3064 F SETBG C 32 3040 F T 3040 PSTO
  3063 PSTO DRLP B
:DRROOM
  OBROOM C DRCELL B
:DREND
  R

:FLUSHDIRTY
  3052 F 3053 F G FDNONE *
  3052 F 3068 T
:FDLP
  3068 F 3053 F G FDDONE *
  3068 F DRAWROW C 3068 PSTO FDLP B
:FDDONE
  99 3052 T 0 3053 T
:FDNONE
  R

:FRAME                     # border, title and key hints
  ESC C  3549  OBS C
  1 1 TG C GREY C 3490 OBS C 3506 OBS C RESET C
  BOLD C 56 SETFG C  3552  OBS C RESET C GREY C
  3506 OBS C OBFLUSH C " 64 codons = 64 colours "
  0 3044 T
:FRLP1
  3044 F 22 / FRL1E *
  3506 OBS C 3044 PSTO FRLP1 B
:FRL1E
  3494 OBS C
  0 3044 T
:FRLP2
  3044 F 20 / FRL2E *
  3044 F 2 A 1 GOTO C 3510 OBS C
  3044 F 2 A 62 GOTO C 3510 OBS C
  3044 PSTO FRLP2 B
:FRL2E
  22 1 GOTO C 3498 OBS C
  0 3044 T
:FRLP3
  3044 F 60 / FRL3E *
  3506 OBS C 3044 PSTO FRLP3 B
:FRL3E
  3502 OBS C
  24 1 TG C GREY C
  OBFLUSH C "arrows move  space paint  ACGT colour  L R B O shapes  F fill  X maths  H help"
  RESET C R

:PANEL                     # palette and info on the right
  3069 F 3070 F E PALEND *
  3069 F 3070 T
  0 3044 T
:PALROW
  3044 F 64 / PALEND *
  3044 F 7 P PALNOGO *
  OBROOM C
  3044 F 3 > 2 A 64 GOTO C
:PALNOGO
  3044 F SETBG C
  3044 F 3069 F E PALSEL *
  32 OBC C 32 OBC C PALNX B
:PALSEL
  3044 F CONTRAST C SETFG C 91 OBC C 93 OBC C
:PALNX
  3044 PSTO PALROW B
:PALEND
  11 64 TG C GREY C  3565  OBS C 3069 F SETBG C 4 OBSP C RESET C 6 OBSP C
  12 64 TG C GREY C  3573  OBS C BOLD C 3069 F CODON C RESET C 7 OBSP C
  13 64 TG C GREY C  3581  OBS C RESET C 3069 F OPNAME C 5 OBSP C
  14 64 TG C GREY C  3589  OBS C RESET C 3069 F HEXRGB C 3 OBSP C
  15 64 TG C GREY C  3597  OBS C RESET C 3069 F AAOF C D AA3 C 32 OBC C 3459 A F OBC C 6 OBSP C
  3071 F VPANEL *
  16 64 TG C GREY C  3605  OBS C RESET C TOOLNAME C
  17 64 TG C GREY C  3613  OBS C RESET C 3072 F OBN C 9 OBSP C
  18 64 TG C GREY C  3621  OBS C RESET C
  3073 F PNMIR1 *
   3629  OBS C PNMIRD B
:PNMIR1
  3073 F 1 E PNMIR2 *
   3640  OBS C PNMIRD B
:PNMIR2
   3651  OBS C
:PNMIRD
  19 64 TG C GREY C  3662  OBS C RESET C
  3074 F PNPEN *
   3670  OBS C PNPEND B
:PNPEN
  56 SETFG C  3676  OBS C RESET C
:PNPEND
  20 64 TG C GREY C  3682  OBS C RESET C
  3075 F PNRB *
   3690  OBS C PNRBD B
:PNRB
   3696  OBS C
:PNRBD
  21 64 TG C GREY C  3702  OBS C RESET C 3066 F OBN C 44 OBC C 3060 F OBN C 4 OBSP C
  R
:TOOLNAME
  3061 F TNPEN J
  3061 F 1 E TNLINE *
  3061 F 2 E TNRECT *
  3061 F 3 E TNBOX *
   3710  OBS C 4 OBSP C R
:TNPEN
   3717  OBS C 7 OBSP C R
:TNLINE
   3721  OBS C 6 OBSP C R
:TNRECT
   3726  OBS C 6 OBSP C R
:TNBOX
   3731  OBS C 7 OBSP C R

:MSG                       # start the message line
  23 1 TG C ESC C  3735  OBS C R
:FULLDRAW
  999 3070 T
  FRAME C ALLDIRTY C FLUSHDIRTY C PANEL C OBFLUSH C R

# =====================================================================
#  pen, brush, mirrors
# =====================================================================
:STAMP                     # (x y --)  brush at x,y and its mirror images
  3076 T 3077 T
  3075 F STNORB J
  3069 F + 63 P 3069 T
:STNORB
  3077 F 3076 F BRUSH C
  3073 F STEND J
  59 3077 F S 3076 F BRUSH C
  3073 F 1 E STEND *
  3077 F 39 3076 F S BRUSH C
  59 3077 F S 39 3076 F S BRUSH C
:STEND
  R
:BRUSH                     # (x y --)  a bsize x bsize square
  3072 F - 2 V D 3078 T
  S 3079 T 3078 F S 3080 T
  0 3081 T
:BRJ
  3081 F 3072 F / BREND *
  0 3082 T
:BRI
  3082 F 3072 F / BRNJ *
  3069 F 3080 F 3082 F A 3079 F 3081 F A SETPX C
  3082 PSTO BRI B
:BRNJ
  3081 PSTO BRJ B
:BREND
  R
:PLOTM                     # (x y --)  one pixel plus mirror images (box, spray)
  3083 T 3084 T
  3069 F 3084 F 3083 F SETPX C
  3073 F PMEND J
  3069 F 59 3084 F S 3083 F SETPX C
  3073 F 1 E PMEND *
  3069 F 3084 F 39 3083 F S SETPX C
  3069 F 59 3084 F S 39 3083 F S SETPX C
:PMEND
  R

# =====================================================================
#  shapes: Bresenham line, rectangle, filled box, midpoint circle
# =====================================================================
:LINE                      # (x0 y0 x1 y1 --)
  3085 T 3086 T 3087 T 3088 T
  3086 F 3088 F S ABS 3089 T
  3085 F 3087 F S ABS ~ 3090 T
  3088 F 3086 F L LSXP *
  0 1 S 3091 T LSXD B
:LSXP
  1 3091 T
:LSXD
  3087 F 3085 F L LSYP *
  0 1 S 3092 T LSYD B
:LSYP
  1 3092 T
:LSYD
  3089 F 3090 F A 3093 T
:LNLP
  3088 F 3087 F STAMP C
  3088 F 3086 F E 3087 F 3085 F E P LNEND *
  3093 F 2 M 3094 T
  3094 F 3090 F L LNY *
  3093 F 3090 F A 3093 T 3088 F 3091 F A 3088 T
:LNY
  3094 F 3089 F G LNLP *
  3093 F 3089 F A 3093 T 3087 F 3092 F A 3087 T
  LNLP B
:LNEND
  R

:RECT                      # anchor to cursor, outline
  3067 F 3062 F 3066 F 3062 F LINE C
  3066 F 3062 F 3066 F 3060 F LINE C
  3066 F 3060 F 3067 F 3060 F LINE C
  3067 F 3060 F 3067 F 3062 F LINE C R

:BOX                       # anchor to cursor, filled
  3067 F 3066 F MIN 3095 T 3067 F 3066 F MAX 3096 T
  3062 F 3060 F MIN 3097 T 3062 F 3060 F MAX 3098 T
:BXY
  3097 F 3098 F G BXEND *
  3095 F 3099 T
:BXX
  3099 F 3096 F G BXNY *
  3099 F 3097 F PLOTM C 3099 PSTO BXX B
:BXNY
  3097 PSTO BXY B
:BXEND
  R

:ISQRT                     # (n -- r)
  3100 T 0
:SQLP
  D + D M 3100 F G SQEND *
  + SQLP B
:SQEND
  R

:CIRCLE                    # centre = anchor, through the cursor
  3066 F 3067 F S D M 3060 F 3062 F S D M A ISQRT C 3101 T
  0 3102 T 1 3101 F S 3103 T
:CILP
  3101 F 3102 F L CIEND *
  3067 F 3101 F A 3062 F 3102 F A STAMP C
  3067 F 3101 F S 3062 F 3102 F A STAMP C
  3067 F 3101 F A 3062 F 3102 F S STAMP C
  3067 F 3101 F S 3062 F 3102 F S STAMP C
  3067 F 3102 F A 3062 F 3101 F A STAMP C
  3067 F 3102 F S 3062 F 3101 F A STAMP C
  3067 F 3102 F A 3062 F 3101 F S STAMP C
  3067 F 3102 F S 3062 F 3101 F S STAMP C
  3102 PSTO
  3103 F 0 L CIPOS J
  3103 F 3102 F 2 M A + 3103 T CILP B
:CIPOS
  3101 F - 3101 T
  3103 F 3102 F 3101 F S 2 M A + 3103 T CILP B
:CIEND
  R

:SPRAY                     # a puff of random dots around the cursor
  14 3104 T
:SPLP
  3104 F SPEND J
  3066 F 9 RAND A 4 S 3060 F 9 RAND A 4 S PLOTM C
  3104 F - 3104 T SPLP B
:SPEND
  R

# =====================================================================
#  flood fill (scanline, explicit stack of y*64+x)
# =====================================================================
:FPUSH                     # (x y --)
  3105 F 720 / FPFULL *
  6 < O 3105 F 1968 A T 3105 PSTO R
:FPFULL
  ] 1 3106 T R
:FILL
  3066 F 3060 F GETPX C 3107 T
  3107 F 3069 F E FLRET *
  0 3105 T 0 3106 T
  3066 F 3060 F FPUSH C
:FLPOP
  3105 F FLRET J
  3105 F - D 3105 T 1968 A F
  D 63 P 3108 T 6 > 3109 T
  3108 F 3109 F GETPX C 3107 F = FLPOP *
:FLLEFT
  3108 F FLSCAN J
  3108 F - 3109 F GETPX C 3107 F = FLSCAN *
  3108 F - 3108 T FLLEFT B
:FLSCAN
  0 3110 T 0 3111 T
:FLRUN
  3108 F 59 G FLPOP *
  3108 F 3109 F GETPX C 3107 F = FLPOP *
  3069 F 3108 F 3109 F SETPX C
  3109 F FLBELOW J
  3108 F 3109 F - GETPX C 3107 F E FLAY *
  0 3110 T FLBELOW B
:FLAY
  3110 F FLBELOW *
  3108 F 3109 F - FPUSH C 1 3110 T
:FLBELOW
  3109 F 39 / FLNX *
  3108 F 3109 F + GETPX C 3107 F E FLBY *
  0 3111 T FLNX B
:FLBY
  3111 F FLNX *
  3108 F 3109 F + FPUSH C 1 3111 T
:FLNX
  3108 PSTO FLRUN B
:FLRET
  R

# =====================================================================
#  maths: X fills the canvas with a formula, V shifts every colour by one
# =====================================================================
:MATHS
  SNAP C
  0 3112 T
:MAY
  3112 F 40 / MAEND *
  0 3113 T
:MAX1
  3113 F 60 / MANY *
  MFORM C 3113 F 3112 F SETPX C
  3113 PSTO MAX1 B
:MANY
  3112 PSTO MAY B
:MAEND
  MSG C  3738  OBS C
  3114 F MNAME C
  3114 F + 8 MOD 3114 T
  ALLDIRTY C R
:MFORM                     # ( -- colour) for pixel $mx,$my
  3114 F
  D MF0 J
  D 1 E MF1 *
  D 2 E MF2 *
  D 3 E MF3 *
  D 4 E MF4 *
  D 5 E MF5 *
  D 6 E MF6 *
  ! 3113 F 8 M 60 V 3112 F 8 M 40 V 8 M A R
:MF0
  ! 3113 F 3112 F X 3069 F A 63 P R
:MF1
  ! 3113 F 3112 F M 3069 F A 63 P R
:MF2
  ! 3113 F 30 S D M 3112 F 20 S D M A 3 > 3069 F A 63 P R
:MF3
  ! 3113 F 3112 F P MF3OFF *
  3069 F R
:MF3OFF
  0 R
:MF4
  ! 3113 F 3112 F A 3069 F A 63 P R
:MF5
  ! 3113 F 30 S D M 3112 F 20 S D M A 2 > 3113 F 3112 F M 3 > X 63 P R
:MF6
  ! 3113 F 2 > 3112 F 2 > A 1 P MF6B *
  3069 F R
:MF6B
  3069 F 63 X R
:MNAME                     # (formula --)
  D MN0 J
  D 1 E MN1 *
  D 2 E MN2 *
  D 3 E MN3 *
  D 4 E MN4 *
  D 5 E MN5 *
  D 6 E MN6 *
  ! OBFLUSH C "the whole codon table, 8 x 8   (X again: next formula)" R
:MN0
  ! OBFLUSH C "x xor y   (X again: next formula, ] [ shift the colours)" R
:MN1
  !  3746  OBS C R
:MN2
  ! OBFLUSH C "rings: distance squared from the centre" R
:MN3
  ! OBFLUSH C "Sierpinski: x and y = 0" R
:MN4
  ! OBFLUSH C "diagonal rainbow: x + y" R
:MN5
  ! OBFLUSH C "interference: distance squared xor x times y" R
:MN6
  ! OBFLUSH C "checkerboard with the complementary codon" R

:CYCLE                     # every pixel's codon + 1
  0 3044 T
:CYLP
  3044 F 600 / CYEND *
  3044 F 0 A F 3115 T 0 3116 T 0 3117 T
:CYK
  3117 F 24 / CYST *
  3115 F 3117 F > 63 P + 63 P 3117 F < 3116 F O 3116 T
  3117 F 6 A 3117 T CYK B
:CYST
  3116 F 3044 F 0 A T 3044 PSTO CYLP B
:CYEND
  ALLDIRTY C 1 3051 T R

# =====================================================================
#  files: FASTA (one codon per pixel) and BMP (480 x 320, 24 bit)
# =====================================================================
:MAKEPATH                  # (ext --)  PATH = NB + ext
  NB2PATH C
  2736 STRLEN C 2736 A STRCPY C R
:NB2PATH
  2688 2736 STRCPY C R
:STRLEN                    # (a -- n)
  D
:SLLP
  D F SLEND J
  + SLLP B
:SLEND
  SWAP S R
:STRCPY                    # (src dst --)
  OVER F OVER T
  OVER F SCEND J
  + SWAP + SWAP STRCPY B
:SCEND
  ] R

:ASKNAME                   # ( -- ok)  edit the file name on the message line
  2688 F ANHAVE *
  3481 2688 STRCPY C
:ANHAVE
:ANLP
  MSG C 3118 F OBS C BOLD C 2688 OBS C RESET C 95 OBC C OBFLUSH C
  0 4145 T 2 TSYS C ANKEY *
  4149 F 1 E ANNO *
  ANLP B
:ANKEY
  4149 F 3119 T
  3119 F 10 E ANYES *
  3119 F 27 E ANNO *
  3119 F 8 E ANBS *
  3119 F 33 L ANLP *
  3119 F 126 G ANLP *
  3119 F 47 E ANLP *
  2688 STRLEN C D 40 / ANFULL *
  2688 A D 3119 F SWAP T + 0 SWAP T ANLP B
:ANFULL
  ! ANLP B
:ANBS
  2688 STRLEN C D ANBS0 J
  - 2688 A 0 SWAP T ANLP B
:ANBS0
  ! ANLP B
:ANYES
  2688 F ANNO J
