# =====================================================================
#  files: FASTA (one codon per pixel) and BMP (480 x 320, 24 bit)
# =====================================================================
:MAKEPATH                  # (ext --)  PATH = NB + ext
  NB2PATH C
  2736 STRLEN C 2736 A STRCPY C R
:NB2PATH
  2688 2736 STRCPY C R
:STRLEN                    # (a -- n)
  D
:SLLP
  D F SLEND J
  + SLLP B
:SLEND
  SWAP S R
:STRCPY                    # (src dst --)
  OVER F OVER T
  OVER F SCEND J
  + SWAP + SWAP STRCPY B
:SCEND
  ] R

:ASKNAME                   # ( -- ok)  edit the file name on the message line
  2688 F ANHAVE *
  3261 2688 STRCPY C
:ANHAVE
:ANLP
  MSG C 2941 F OBS C BOLD C 2688 OBS C RESET C 95 OBC C OBFLUSH C
  0 4145 T 2 TSYS C ANKEY *
  4149 F 1 E ANNO *
  ANLP B
:ANKEY
  4149 F 2942 T
  2942 F 10 E ANYES *
  2942 F 27 E ANNO *
  2942 F 8 E ANBS *
  2942 F 33 L ANLP *
  2942 F 126 G ANLP *
  2942 F 47 E ANLP *
  2688 STRLEN C D 40 / ANFULL *
  2688 A D 2942 F SWAP T + 0 SWAP T ANLP B
:ANFULL
  ! ANLP B
:ANBS
  2688 STRLEN C D ANBS0 J
  - 2688 A 0 SWAP T ANLP B
:ANBS0
  ! ANLP B
:ANYES
  2688 F ANNO J
  1 R
:ANNO
  0 R

:NEEDFS                    # ( -- ok)
  4138 F 18003 E NFOK *
  MSG C 53 SETFG C OBFLUSH C "saving and loading need --fs:  python3 GATCnux.py run paint.aa --tty --fs" RESET C 0 R
:NFOK
  1 R

:SAVE
  NEEDFS C SVRET J
   3524  2941 T
  ASKNAME C SVRET J
   3534  MAKEPATH C
  2736 4129 T 1 4130 T 9 FSYS C SVFAIL J
  OBFLUSH C 4134 F 2865 T
   3538  OBS C  3550  OBS C 2688 OBS C 10 OBC C
  0 2868 T
:SFLP
  2868 F 2400 / SFEND *
