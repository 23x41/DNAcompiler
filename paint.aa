# =====================================================================
# paint.aa  --  GATC PAINT: a 64-colour pixel painter for the GATC VM
#
#   python3 GATCnux.py run paint.aa --no-banner --tty --fs --max-steps 2000000000
#
# 64 codons = 64 colours.  A codon's three bases are its red, green and blue
# levels (A 0, C 85, G 170, T 255), so the colour number is the codon's own
# 6-bit value - and every colour is also one of the VM's 64 instructions.
# Type three bases (e.g. G C A) to pick a colour.
#
# Pictures are saved as a FASTA DNA sequence (one codon per pixel) that can be
# loaded again, plus a BMP image (480x320) that any viewer opens.
#
# --tty (GATCnux.py) gives raw keys, the mouse and fast screen writes;
# --fs is only needed for saving and loading.  Everything else - the canvas,
# drawing, lines, circles, flood fill, mirrors, maths patterns, FASTA and BMP
# encoding - is GATC assembly.
#
# Generated from paint.tpl by gen_aa.py.  No negative literals (DNA-safe).
# Memory map (generated):
#       0..  599  CANVAS
#     600.. 1199  UNDO
#    1200.. 1967  OB
#    1968.. 2687  FSTACK
#    2688.. 2735  NB
#    2736.. 2799  PATH
#    2800.. 2863  XT
#    2864.. 2974  variables (111)
#    2975.. 3782  strings (76)   free: 313 cells
# =====================================================================




MAIN B

# =====================================================================
#  bridges
# =====================================================================
:TSYS                      # (cmd -- status)
  4144 T 4148 F R
:FSYS                      # (cmd -- status)
  4128 T 4133 F R

# =====================================================================
#  output buffer: everything on screen goes through OB, one write per frame
#  ($obfd = 0: the terminal, else a file handle from the fs bridge)
# =====================================================================
:OBC                       # (byte --)  no bounds check: callers use OBROOM
  2864 F T 2864 PSTO R
:OBROOM                    # make sure there is room for ~60 more bytes
  2864 F 1200 S 700 L OBRR *
  OBFLUSH B
:OBRR
  R
:OBFLUSH
  2864 F 1200 S D OBFZ J
  2865 F OBFILE *
  1200 4145 T 4146 T 3 TSYS C !
  1200 2864 T R
:OBFILE
  1200 4130 T 4131 T 2865 F 4129 T 11 FSYS C !
  1200 2864 T R
:OBFZ
  ! R
:OBS                       # (addr --)  append a NUL-terminated string
  OBROOM C
:OBSLP
  D F OBSEND J
  D F OBC C + OBSLP B
:OBSEND
  ! R
:OBN                       # (n --)  decimal
  D 10 L OBN1 *
  D 10 V OBN C
  10 MOD
:OBN1
  48 A OBC C R
:OBSP                      # (k --)  k spaces
  D 1 L OBSPE *
  32 OBC C - OBSP B
:OBSPE
  ! R
:ESC                       # ESC [
  27 OBC C 91 OBC C R
:GOTO                      # (row col --)
  SWAP ESC C OBN C 59 OBC C OBN C 72 OBC C R
:RESET                     # plain colours
  ESC C 48 OBC C 109 OBC C 999 2866 T 999 2867 T R
:TG                        # (row col --)  move there with plain colours
  GOTO C RESET C R
:XTOUT                     # (colour --)  its xterm number, 2 or 3 digits
  2800 A F
  D 100 L XT2 *
  D 100 V 48 A OBC C
:XT2
  D 10 V 10 MOD 48 A OBC C 10 MOD 48 A OBC C R
:FG5                       # "38;5;"
  51 OBC C 56 OBC C 59 OBC C 53 OBC C 59 OBC C R
:BG5                       # "48;5;"
  52 OBC C 56 OBC C 59 OBC C 53 OBC C 59 OBC C R
:SETFG                     # (colour --)  only emitted when it changes
  D 2866 F E SFSAME *
  D 2866 T
  27 OBC C 91 OBC C FG5 C XTOUT C 109 OBC C R
:SFSAME
  ! R
:SETBG
  D 2867 F E SFSAME *
  D 2867 T
  27 OBC C 91 OBC C BG5 C XTOUT C 109 OBC C R
:COLORS                    # (fg bg --)  one escape for whatever changed
  D 2867 F E CLBGSAME *
  OVER 2866 F E CLFGSAME *
  D 2867 T OVER 2866 T
  27 OBC C 91 OBC C SWAP FG5 C XTOUT C 59 OBC C BG5 C XTOUT C 109 OBC C R
:CLFGSAME
  NIP SETBG B
:CLBGSAME
  ! SETFG B
:GREY                      # dim grey text
  ESC C  3298  OBS C 999 2866 T 999 2867 T R
:BOLD
  ESC C  3310  OBS C R

# =====================================================================
#  colours
# =====================================================================
:XTINIT                    # colour -> xterm-256 index (levels 0 95 175 255)
  0 2868 T
:XTLP
  2868 F 64 / XTEND *
  2868 F 4 > LV C 36 M
  2868 F 2 > 3 P LV C 6 M A
  2868 F 3 P LV C A 16 A
  2868 F 2800 A T
  2868 PSTO XTLP B
:XTEND
  R
:LV                        # (0..3 -- 0 1 3 5)
  D 2 / LVHI *
  R
:LVHI
  D A - R

:CONTRAST                  # (colour -- black or white)
  D 4 > 2 M OVER 2 > 3 P 5 M A SWAP 3 P A
  12 / CTBLK *
  63 R
:CTBLK
  0 R

:CODON                     # (colour --)  three base letters, each in its own hue
  2869 T
  2869 F 4 > BASEOUT C
  2869 F 2 > 3 P BASEOUT C
  2869 F 3 P BASEOUT C R
:BASEOUT                   # (base --)
  D BASECOL C SETFG C
  3256 A F OBC C R
:BASECOL                   # (base -- colour)  A blue CCT, C amber TGA, G green CTC, T coral TCC
  D BCA J
  D 1 E BCC *
  D 2 E BCG *
  ! 53 R
:BCA
  ! 23 R
:BCC
  ! 56 R
:BCG
  ! 29 R

:OPNAME                    # (colour --)  the instruction this codon encodes
  2975 SWAP
:ONLP
  D ONGO J
  SWAP
:ONSKIP
  D F 32 = ONNEXT1 *
  + SWAP - ONLP B
:ONNEXT1
  + ONSKIP B
:ONGO
  !
:ONPR
  D F D 32 = OVER BOOL P ONPC *
  ] R
:ONPC
  OBC C + ONPR B

:HEXRGB                    # (colour --)  #RRGGBB
  35 OBC C
  D 4 > HEX85 C D 2 > 3 P HEX85 C 3 P HEX85 C R
:HEX85                     # (level --)  00 55 AA FF
  D HX0 J
  D 1 E HX5 *
  D 2 E HXA *
  !  3313  OBS C R
:HX0
  !  3316  OBS C R
:HX5
  !  3319  OBS C R
:HXA
  !  3322  OBS C R

# =====================================================================
#  canvas: 60 x 40 pixels, 4 pixels (6 bits each) per memory cell
# =====================================================================
:PXADDR                    # (x y -- addr shift)
  60 M A
  D 2 > 0 A
  SWAP 3 P 6 M R
:GETPX                     # (x y -- colour)
  PXADDR C 2870 T F 2870 F > 63 P R
:SETPX                     # (colour x y --)  ignores points outside the canvas
  2871 T 2872 T 2873 T
  2872 F 0 L SPXOUT *
  2872 F 59 G SPXOUT *
  2871 F 0 L SPXOUT *
  2871 F 39 G SPXOUT *
  2871 F 1 > DIRTY C
  2872 F 2871 F PXADDR C 2870 T 2874 T
  2874 F F 63 2870 F < INV P 2873 F 2870 F < O 2874 F T
  1 2875 T
:SPXOUT
  R
:DIRTY                     # (terminal row --)
  D 2876 F MIN 2876 T 2877 F MAX 2877 T R
:ALLDIRTY
  0 2876 T 19 2877 T R

:SNAP                      # copy the canvas to the undo buffer
  0 2868 T
:SNLP
  2868 F 600 / SNEND *
  2868 F 0 A F 2868 F 600 A T 2868 PSTO SNLP B
:SNEND
  R
:UNDOSWAP                  # undo (press again to redo)
  0 2868 T
:USLP
  2868 F 600 / USEND *
  2868 F 0 A F 2868 F 600 A F 2868 F 0 A T 2868 F 600 A T
  2868 PSTO USLP B
:USEND
  ALLDIRTY C 1 2875 T R
:CLEARC                    # (colour --)  fill the whole canvas
  2878 T 0 2868 T
  2878 F 2878 F 6 < O D 12 < O 2878 T
:CCLP
  2868 F 600 / CCEND *
  2878 F 2868 F 0 A T 2868 PSTO CCLP B
:CCEND
  ALLDIRTY C 1 2875 T R

# =====================================================================
#  drawing on the screen
# =====================================================================
:PXI                       # (pixel index -- colour)
  D 2 > 0 A F SWAP 3 P 6 M > 63 P R
:DRAWROW                   # (terminal row 0..19)  two pixel rows as half blocks
  2879 T
  OBROOM C
  2879 F 2 A 2 GOTO C
  2879 F 120 M 2880 T
  2879 F 2 M 2881 T
  0 2882 T 0 2883 T
  2884 F 1 > 2879 F E 2882 T
  2885 F 2886 F 1 > 2879 F E P 2883 T
  0 2887 T
:DRLP
  2887 F 60 / DREND *
  2880 F 2887 F A D PXI C 2888 T 60 A PXI C 2889 T
  2882 F DRNOC J
  2887 F 2890 F = DRNOC *
  2881 F 2884 F E DRCT *
  2889 F CONTRAST C 2889 T DRNOC B
:DRCT
  2888 F CONTRAST C 2888 T
:DRNOC
  2883 F DRNOA J
  2887 F 2891 F = DRNOA *
  2881 F 2886 F E DRAT *
  2889 F CONTRAST C 2889 T DRNOA B
:DRAT
  2888 F CONTRAST C 2888 T
:DRNOA
  2887 F 7 P DRROOM J
:DRCELL
  2888 F 2889 F E DRSAME *
  2888 F 2889 F COLORS C
  226 OBC C 150 OBC C 128 OBC C
  2887 PSTO DRLP B
:DRSAME
  2888 F SETBG C 32 OBC C
  2887 PSTO DRLP B
:DRROOM
  OBROOM C DRCELL B
:DREND
  R

:FLUSHDIRTY
  2876 F 2877 F G FDNONE *
  2876 F 2892 T
:FDLP
  2892 F 2877 F G FDDONE *
  2892 F DRAWROW C 2892 PSTO FDLP B
:FDDONE
  99 2876 T 0 2877 T
:FDNONE
  R

:FRAME                     # border, title and key hints
  ESC C  3325  OBS C
  1 1 TG C GREY C 3270 OBS C 3286 OBS C RESET C
  BOLD C 56 SETFG C  3328  OBS C RESET C GREY C
  3286 OBS C OBFLUSH C " 64 codons = 64 colours "
  0 2868 T
:FRLP1
  2868 F 22 / FRL1E *
  3286 OBS C 2868 PSTO FRLP1 B
:FRL1E
  3274 OBS C
  0 2868 T
:FRLP2
  2868 F 20 / FRL2E *
  2868 F 2 A 1 GOTO C 3290 OBS C
  2868 F 2 A 62 GOTO C 3290 OBS C
  2868 PSTO FRLP2 B
:FRL2E
  22 1 GOTO C 3278 OBS C
  0 2868 T
:FRLP3
  2868 F 60 / FRL3E *
  3286 OBS C 2868 PSTO FRLP3 B
:FRL3E
  3282 OBS C
  24 1 TG C GREY C
  OBFLUSH C "arrows move  space paint  ACGT colour  L R B O shapes  F fill  X maths  H help"
  RESET C R

:PANEL                     # palette and info on the right
  2893 F 2894 F E PALEND *
  2893 F 2894 T
  0 2868 T
:PALROW
  2868 F 64 / PALEND *
  2868 F 7 P PALNOGO *
  OBROOM C
  2868 F 3 > 2 A 64 GOTO C
:PALNOGO
  2868 F SETBG C
  2868 F 2893 F E PALSEL *
  32 OBC C 32 OBC C PALNX B
:PALSEL
  2868 F CONTRAST C SETFG C 91 OBC C 93 OBC C
:PALNX
  2868 PSTO PALROW B
:PALEND
  11 64 TG C GREY C  3341  OBS C 2893 F SETBG C 4 OBSP C RESET C 6 OBSP C
  12 64 TG C GREY C  3349  OBS C BOLD C 2893 F CODON C RESET C 7 OBSP C
  13 64 TG C GREY C  3357  OBS C RESET C 2893 F OPNAME C 5 OBSP C
  14 64 TG C GREY C  3365  OBS C RESET C 2893 F HEXRGB C 3 OBSP C
  16 64 TG C GREY C  3373  OBS C RESET C TOOLNAME C
  17 64 TG C GREY C  3381  OBS C RESET C 2895 F OBN C 9 OBSP C
  18 64 TG C GREY C  3389  OBS C RESET C
  2896 F PNMIR1 *
   3397  OBS C PNMIRD B
:PNMIR1
  2896 F 1 E PNMIR2 *
   3408  OBS C PNMIRD B
:PNMIR2
   3419  OBS C
:PNMIRD
  19 64 TG C GREY C  3430  OBS C RESET C
  2897 F PNPEN *
   3438  OBS C PNPEND B
:PNPEN
  56 SETFG C  3444  OBS C RESET C
:PNPEND
  20 64 TG C GREY C  3450  OBS C RESET C
  2898 F PNRB *
   3458  OBS C PNRBD B
:PNRB
   3464  OBS C
:PNRBD
  21 64 TG C GREY C  3470  OBS C RESET C 2890 F OBN C 44 OBC C 2884 F OBN C 4 OBSP C
  R
:TOOLNAME
  2885 F TNPEN J
  2885 F 1 E TNLINE *
  2885 F 2 E TNRECT *
  2885 F 3 E TNBOX *
   3478  OBS C 4 OBSP C R
:TNPEN
   3485  OBS C 7 OBSP C R
:TNLINE
   3489  OBS C 6 OBSP C R
:TNRECT
   3494  OBS C 6 OBSP C R
:TNBOX
   3499  OBS C 7 OBSP C R

:MSG                       # start the message line
  23 1 TG C ESC C  3503  OBS C R
:FULLDRAW
  999 2894 T
  FRAME C ALLDIRTY C FLUSHDIRTY C PANEL C OBFLUSH C R

# =====================================================================
#  pen, brush, mirrors
# =====================================================================
:STAMP                     # (x y --)  brush at x,y and its mirror images
  2899 T 2900 T
  2898 F STNORB J
  2893 F + 63 P 2893 T
:STNORB
  2900 F 2899 F BRUSH C
  2896 F STEND J
  59 2900 F S 2899 F BRUSH C
  2896 F 1 E STEND *
  2900 F 39 2899 F S BRUSH C
  59 2900 F S 39 2899 F S BRUSH C
:STEND
  R
:BRUSH                     # (x y --)  a bsize x bsize square
  2895 F - 2 V D 2901 T
  S 2902 T 2901 F S 2903 T
  0 2904 T
:BRJ
  2904 F 2895 F / BREND *
  0 2905 T
:BRI
  2905 F 2895 F / BRNJ *
  2893 F 2903 F 2905 F A 2902 F 2904 F A SETPX C
  2905 PSTO BRI B
:BRNJ
  2904 PSTO BRJ B
:BREND
  R
:PLOTM                     # (x y --)  one pixel plus mirror images (box, spray)
  2906 T 2907 T
  2893 F 2907 F 2906 F SETPX C
  2896 F PMEND J
  2893 F 59 2907 F S 2906 F SETPX C
  2896 F 1 E PMEND *
  2893 F 2907 F 39 2906 F S SETPX C
  2893 F 59 2907 F S 39 2906 F S SETPX C
:PMEND
  R

# =====================================================================
#  shapes: Bresenham line, rectangle, filled box, midpoint circle
# =====================================================================
:LINE                      # (x0 y0 x1 y1 --)
  2908 T 2909 T 2910 T 2911 T
  2909 F 2911 F S ABS 2912 T
  2908 F 2910 F S ABS ~ 2913 T
  2911 F 2909 F L LSXP *
  0 1 S 2914 T LSXD B
:LSXP
  1 2914 T
:LSXD
  2910 F 2908 F L LSYP *
  0 1 S 2915 T LSYD B
:LSYP
  1 2915 T
:LSYD
  2912 F 2913 F A 2916 T
:LNLP
  2911 F 2910 F STAMP C
  2911 F 2909 F E 2910 F 2908 F E P LNEND *
  2916 F 2 M 2917 T
  2917 F 2913 F L LNY *
  2916 F 2913 F A 2916 T 2911 F 2914 F A 2911 T
:LNY
  2917 F 2912 F G LNLP *
  2916 F 2912 F A 2916 T 2910 F 2915 F A 2910 T
  LNLP B
:LNEND
  R

:RECT                      # anchor to cursor, outline
  2891 F 2886 F 2890 F 2886 F LINE C
  2890 F 2886 F 2890 F 2884 F LINE C
  2890 F 2884 F 2891 F 2884 F LINE C
  2891 F 2884 F 2891 F 2886 F LINE C R

:BOX                       # anchor to cursor, filled
  2891 F 2890 F MIN 2918 T 2891 F 2890 F MAX 2919 T
  2886 F 2884 F MIN 2920 T 2886 F 2884 F MAX 2921 T
:BXY
  2920 F 2921 F G BXEND *
  2918 F 2922 T
:BXX
  2922 F 2919 F G BXNY *
  2922 F 2920 F PLOTM C 2922 PSTO BXX B
:BXNY
  2920 PSTO BXY B
:BXEND
  R

:ISQRT                     # (n -- r)
  2923 T 0
:SQLP
  D + D M 2923 F G SQEND *
  + SQLP B
:SQEND
  R

:CIRCLE                    # centre = anchor, through the cursor
  2890 F 2891 F S D M 2884 F 2886 F S D M A ISQRT C 2924 T
  0 2925 T 1 2924 F S 2926 T
:CILP
  2924 F 2925 F L CIEND *
  2891 F 2924 F A 2886 F 2925 F A STAMP C
  2891 F 2924 F S 2886 F 2925 F A STAMP C
  2891 F 2924 F A 2886 F 2925 F S STAMP C
  2891 F 2924 F S 2886 F 2925 F S STAMP C
  2891 F 2925 F A 2886 F 2924 F A STAMP C
  2891 F 2925 F S 2886 F 2924 F A STAMP C
  2891 F 2925 F A 2886 F 2924 F S STAMP C
  2891 F 2925 F S 2886 F 2924 F S STAMP C
  2925 PSTO
  2926 F 0 L CIPOS J
  2926 F 2925 F 2 M A + 2926 T CILP B
:CIPOS
  2924 F - 2924 T
  2926 F 2925 F 2924 F S 2 M A + 2926 T CILP B
:CIEND
  R

:SPRAY                     # a puff of random dots around the cursor
  14 2927 T
:SPLP
  2927 F SPEND J
  2890 F 9 RAND A 4 S 2884 F 9 RAND A 4 S PLOTM C
  2927 F - 2927 T SPLP B
:SPEND
  R

# =====================================================================
#  flood fill (scanline, explicit stack of y*64+x)
# =====================================================================
:FPUSH                     # (x y --)
  2928 F 720 / FPFULL *
  6 < O 2928 F 1968 A T 2928 PSTO R
:FPFULL
  ] 1 2929 T R
:FILL
  2890 F 2884 F GETPX C 2930 T
  2930 F 2893 F E FLRET *
  0 2928 T 0 2929 T
  2890 F 2884 F FPUSH C
:FLPOP
  2928 F FLRET J
  2928 F - D 2928 T 1968 A F
  D 63 P 2931 T 6 > 2932 T
  2931 F 2932 F GETPX C 2930 F = FLPOP *
:FLLEFT
  2931 F FLSCAN J
  2931 F - 2932 F GETPX C 2930 F = FLSCAN *
  2931 F - 2931 T FLLEFT B
:FLSCAN
  0 2933 T 0 2934 T
:FLRUN
  2931 F 59 G FLPOP *
  2931 F 2932 F GETPX C 2930 F = FLPOP *
  2893 F 2931 F 2932 F SETPX C
  2932 F FLBELOW J
  2931 F 2932 F - GETPX C 2930 F E FLAY *
  0 2933 T FLBELOW B
:FLAY
  2933 F FLBELOW *
  2931 F 2932 F - FPUSH C 1 2933 T
:FLBELOW
  2932 F 39 / FLNX *
  2931 F 2932 F + GETPX C 2930 F E FLBY *
  0 2934 T FLNX B
:FLBY
  2934 F FLNX *
  2931 F 2932 F + FPUSH C 1 2934 T
:FLNX
  2931 PSTO FLRUN B
:FLRET
  R

# =====================================================================
#  maths: X fills the canvas with a formula, V shifts every colour by one
# =====================================================================
:MATHS
  SNAP C
  0 2935 T
:MAY
  2935 F 40 / MAEND *
  0 2936 T
:MAX1
  2936 F 60 / MANY *
  MFORM C 2936 F 2935 F SETPX C
  2936 PSTO MAX1 B
:MANY
  2935 PSTO MAY B
:MAEND
  MSG C  3506  OBS C
  2937 F MNAME C
  2937 F + 8 MOD 2937 T
  ALLDIRTY C R
:MFORM                     # ( -- colour) for pixel $mx,$my
  2937 F
  D MF0 J
  D 1 E MF1 *
  D 2 E MF2 *
  D 3 E MF3 *
  D 4 E MF4 *
  D 5 E MF5 *
  D 6 E MF6 *
  ! 2936 F 8 M 60 V 2935 F 8 M 40 V 8 M A R
:MF0
  ! 2936 F 2935 F X 2893 F A 63 P R
:MF1
  ! 2936 F 2935 F M 2893 F A 63 P R
:MF2
  ! 2936 F 30 S D M 2935 F 20 S D M A 3 > 2893 F A 63 P R
:MF3
  ! 2936 F 2935 F P MF3OFF *
  2893 F R
:MF3OFF
  0 R
:MF4
  ! 2936 F 2935 F A 2893 F A 63 P R
:MF5
  ! 2936 F 30 S D M 2935 F 20 S D M A 2 > 2936 F 2935 F M 3 > X 63 P R
:MF6
  ! 2936 F 2 > 2935 F 2 > A 1 P MF6B *
  2893 F R
:MF6B
  2893 F 63 X R
:MNAME                     # (formula --)
  D MN0 J
  D 1 E MN1 *
  D 2 E MN2 *
  D 3 E MN3 *
  D 4 E MN4 *
  D 5 E MN5 *
  D 6 E MN6 *
  ! OBFLUSH C "the whole codon table, 8 x 8   (X again: next formula)" R
:MN0
  ! OBFLUSH C "x xor y   (X again: next formula, ] [ shift the colours)" R
:MN1
  !  3514  OBS C R
:MN2
  ! OBFLUSH C "rings: distance squared from the centre" R
:MN3
  ! OBFLUSH C "Sierpinski: x and y = 0" R
:MN4
  ! OBFLUSH C "diagonal rainbow: x + y" R
:MN5
  ! OBFLUSH C "interference: distance squared xor x times y" R
:MN6
  ! OBFLUSH C "checkerboard with the complementary codon" R

:CYCLE                     # every pixel's codon + 1
  0 2868 T
:CYLP
  2868 F 600 / CYEND *
  2868 F 0 A F 2938 T 0 2939 T 0 2940 T
:CYK
  2940 F 24 / CYST *
  2938 F 2940 F > 63 P + 63 P 2940 F < 2939 F O 2939 T
  2940 F 6 A 2940 T CYK B
:CYST
  2939 F 2868 F 0 A T 2868 PSTO CYLP B
:CYEND
