  ! ANLP B
:ANBS
  2688 STRLEN C D ANBS0 J
  - 2688 A 0 SWAP T ANLP B
:ANBS0
  ! ANLP B
:ANYES
  2688 F ANNO J
  1 R
:ANNO
  0 R

