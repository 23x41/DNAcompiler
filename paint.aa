:AANOTE                    # (aa --) a short note, up to three lines
  2 M AANOTET A B
:AANOTET
  AANOTE0 B
  AANOTE1 B
  AANOTE2 B
  AANOTE3 B
  AANOTE4 B
  AANOTE5 B
  AANOTE6 B
  AANOTE7 B
  AANOTE8 B
  AANOTE9 B
  AANOTE10 B
  AANOTE11 B
  AANOTE12 B
  AANOTE13 B
  AANOTE14 B
  AANOTE15 B
  AANOTE16 B
  AANOTE17 B
  AANOTE18 B
  AANOTE19 B
  AANOTE20 B
:AANOTE0
  17 2 GOTO C OBFLUSH C "Small and very common; one of the strongest"
  18 2 GOTO C OBFLUSH C "helix-forming residues in proteins."
  R
:AANOTE1
  17 2 GOTO C OBFLUSH C "Two cysteines can join through their thiol"
  18 2 GOTO C OBFLUSH C "groups into a disulfide bond that holds a"
  19 2 GOTO C OBFLUSH C "protein in shape."
  R
:AANOTE2
  17 2 GOTO C OBFLUSH C "Negatively charged at body pH; often binds"
  18 2 GOTO C OBFLUSH C "metal ions and works in enzyme active sites."
  R
:AANOTE3
  17 2 GOTO C OBFLUSH C "The brain's main excitatory neurotransmitter,"
  18 2 GOTO C OBFLUSH C "and the source of umami taste (MSG is its"
  19 2 GOTO C OBFLUSH C "sodium salt)."
  R
:AANOTE4
  17 2 GOTO C OBFLUSH C "The body turns it into tyrosine; people with"
  18 2 GOTO C OBFLUSH C "phenylketonuria (PKU) cannot break it down."
  R
:AANOTE5
  17 2 GOTO C OBFLUSH C "The smallest amino acid and the only one with"
  18 2 GOTO C OBFLUSH C "no chiral centre; it lets chains bend and"
  19 2 GOTO C OBFLUSH C "makes up about a third of collagen."
  R
:AANOTE6
  17 2 GOTO C OBFLUSH C "Its side chain gains or loses a proton near"
  18 2 GOTO C OBFLUSH C "body pH, so it often does the chemistry in"
  19 2 GOTO C OBFLUSH C "enzyme active sites."
  R
:AANOTE7
  17 2 GOTO C OBFLUSH C "A branched-chain amino acid (BCAA) with two"
  18 2 GOTO C OBFLUSH C "chiral centres; mostly buried inside folded"
  19 2 GOTO C OBFLUSH C "proteins."
  R
:AANOTE8
  17 2 GOTO C OBFLUSH C "Positively charged; lysines on histones are"
  18 2 GOTO C OBFLUSH C "acetylated and methylated to switch genes on"
  19 2 GOTO C OBFLUSH C "and off."
  R
:AANOTE9
  17 2 GOTO C OBFLUSH C "A branched-chain amino acid and one of the"
  18 2 GOTO C OBFLUSH C "most common in proteins; it gives the leucine"
  19 2 GOTO C OBFLUSH C "zipper its name."
  R
:AANOTE10
  17 2 GOTO C OBFLUSH C "Its only codon, ATG, is also the start codon,"
  18 2 GOTO C OBFLUSH C "so almost every new protein begins with"
  19 2 GOTO C OBFLUSH C "methionine."
  R
:AANOTE11
  17 2 GOTO C OBFLUSH C "Sugar chains attach to it in N-linked"
  18 2 GOTO C OBFLUSH C "glycosylation; the first amino acid ever"
  19 2 GOTO C OBFLUSH C "isolated (from asparagus, 1806)."
  R
:AANOTE12
  17 2 GOTO C OBFLUSH C "Its ring locks the backbone, putting kinks in"
  18 2 GOTO C OBFLUSH C "chains; it breaks helices and is abundant in"
  19 2 GOTO C OBFLUSH C "collagen."
  R
:AANOTE13
  17 2 GOTO C OBFLUSH C "The most abundant free amino acid in the"
  18 2 GOTO C OBFLUSH C "blood; it carries nitrogen between tissues."
  R
:AANOTE14
  17 2 GOTO C OBFLUSH C "Carries a positive charge at body pH; the body"
  18 2 GOTO C OBFLUSH C "makes the signalling molecule nitric oxide"
  19 2 GOTO C OBFLUSH C "(NO) from it."
  R
:AANOTE15
  17 2 GOTO C OBFLUSH C "A common phosphorylation site, and the key"
  18 2 GOTO C OBFLUSH C "residue in serine proteases such as trypsin."
  R
:AANOTE16
  17 2 GOTO C OBFLUSH C "Its hydroxyl group is a frequent"
  18 2 GOTO C OBFLUSH C "phosphorylation site; it has two chiral"
  19 2 GOTO C OBFLUSH C "centres."
  R
:AANOTE17
  17 2 GOTO C OBFLUSH C "A branched-chain amino acid; valine replacing"
  18 2 GOTO C OBFLUSH C "glutamic acid in hemoglobin causes sickle cell"
  19 2 GOTO C OBFLUSH C "disease."
  R
:AANOTE18
  17 2 GOTO C OBFLUSH C "The largest amino acid, with a single codon"
  18 2 GOTO C OBFLUSH C "(TGG); the body makes serotonin and melatonin"
  19 2 GOTO C OBFLUSH C "from it."
  R
:AANOTE19
  17 2 GOTO C OBFLUSH C "Phosphorylated by tyrosine kinases in cell"
  18 2 GOTO C OBFLUSH C "signalling; precursor of dopamine, adrenaline"
  19 2 GOTO C OBFLUSH C "and thyroid hormones."
  R
:AANOTE20
  STOPNOTE B

:STOPNOTE                  # the three stop codons: name and note
  3069 F 48 E STOPTAA *
  3069 F 50 E STOPTAG *
  3069 F 56 E STOPTGA *
  R
:STOPTAA
  10 29 GOTO C BOLD C OBFLUSH C "(ochre)" RESET C
  17 2 GOTO C OBFLUSH C "No tRNA reads it: release factors bind here"
  18 2 GOTO C OBFLUSH C "and free the finished protein. The most common"
  19 2 GOTO C OBFLUSH C "stop codon in E. coli."
  R
:STOPTAG
  10 29 GOTO C BOLD C OBFLUSH C "(amber)" RESET C
  17 2 GOTO C OBFLUSH C "The rarest stop codon in E. coli. Some archaea"
  18 2 GOTO C OBFLUSH C "and bacteria read it as pyrrolysine (Pyl, O);"
  19 2 GOTO C OBFLUSH C "labs reuse it to add new amino acids."
  R
:STOPTGA
  10 29 GOTO C BOLD C OBFLUSH C "(opal)" RESET C
  17 2 GOTO C OBFLUSH C "With a SECIS signal in the mRNA it encodes"
  18 2 GOTO C OBFLUSH C "selenocysteine (Sec, U), the 21st amino acid;"
  19 2 GOTO C OBFLUSH C "in mitochondria it reads as tryptophan."
  R

:AAOF                      # (codon -- amino acid index)
  2 M AATAB A C R
:AAINFO                    # (codon --)  "TCC: VM instruction IN, amino acid Serine (Ser/S)"
  D 3153 T
  BOLD C CODON C RESET C  3930  OBS C 3153 F OPNAME C
  3153 F AAOF C D 20 E AISTOP *
  OBFLUSH C ", amino acid " D AANAME C OBFLUSH C " (" D AA3 C 47 OBC C 3459 A F OBC C 41 OBC C
  GREY C OBFLUSH C "   D: codon card" RESET C R
:AISTOP
  ! OBFLUSH C ", " 53 SETFG C OBFLUSH C "STOP codon" RESET C GREY C OBFLUSH C " - ends the protein   D: codon card" RESET C R

:TCAGIX                    # (0..3 in T C A G order -- base index A C G T)
  D TCT J
  D 1 E TCC *
  D 2 E TCA *
  ! 2 R
:TCT
  ! 3 R
:TCC
  ! 1 R
:TCA
  ! 0 R

:CARD                      # D: everything about the current codon
  OBFLUSH C RESET C ESC C  3549  OBS C
  1 2 GOTO C BOLD C 56 SETFG C OBFLUSH C "CODON CARD" RESET C GREY C OBFLUSH C "   standard genetic code    left/right: next codon    any key: back" RESET C
  3069 F 3154 T 3154 F AAOF C 3155 T
  3 2 GOTO C GREY C OBFLUSH C "DNA codon       " RESET C BOLD C
  3154 F 4 > BASEOUT C 32 OBC C 3154 F 2 > 3 P BASEOUT C 32 OBC C 3154 F 3 P BASEOUT C RESET C
  4 OBSP C 3154 F SETBG C 6 OBSP C RESET C 32 OBC C 3154 F HEXRGB C
  4 2 GOTO C GREY C OBFLUSH C "mRNA codon      " RESET C
  3154 F 4 > RNAB C 32 OBC C 3154 F 2 > 3 P RNAB C 32 OBC C 3154 F 3 P RNAB C
  5 2 GOTO C GREY C OBFLUSH C "tRNA anticodon  " RESET C  3936  OBS C
  3 3154 F 3 P S RNAB C 3 3154 F 2 > 3 P S RNAB C 3 3154 F 4 > S RNAB C  3940  OBS C
  6 2 GOTO C GREY C OBFLUSH C "other strand    " RESET C  3936  OBS C
  3 3154 F 3 P S DNAB C 3 3154 F 2 > 3 P S DNAB C 3 3154 F 4 > S DNAB C  3940  OBS C
  GREY C OBFLUSH C "  (reverse complement)" RESET C
  7 2 GOTO C GREY C OBFLUSH C "GC content      " RESET C
  3154 F 4 > GCB C 3154 F 2 > 3 P GCB C A 3154 F 3 P GCB C A
  D OBN C OBFLUSH C " of 3 bases (" 100 M + 3 V OBN C  3944  OBS C
  8 2 GOTO C GREY C OBFLUSH C "VM instruction  " RESET C 3154 F OPNAME C
  10 2 GOTO C GREY C OBFLUSH C "amino acid      " RESET C BOLD C 3155 F AANAME C RESET C
  3155 F 20 E CDSTOP *
   3947  OBS C 3155 F AA3 C  3951  OBS C 3155 F 3459 A F OBC C 41 OBC C
:CDSTOP
  11 2 GOTO C GREY C OBFLUSH C "side chain      " RESET C 3155 F AASIDE C
  12 2 GOTO C GREY C OBFLUSH C "mass            " RESET C 3155 F AAMASS C
  13 2 GOTO C GREY C OBFLUSH C "essential       " RESET C 3155 F AAESS C
  14 2 GOTO C GREY C OBFLUSH C "codons          " RESET C
  0 3156 T 0 3157 T
:CDSYN                     # every codon for the same amino acid
  OBROOM C
  3157 F 64 / CDSYND *
  3157 F AAOF C 3155 F = CDSYNX *
  3156 PSTO
  3157 F 3154 F E CDSYNB *
  3157 F CODON C RESET C 32 OBC C CDSYNX B
:CDSYNB
  91 OBC C BOLD C 3157 F CODON C RESET C 93 OBC C 32 OBC C
:CDSYNX
  3157 PSTO CDSYN B
:CDSYND
  15 18 GOTO C GREY C 3156 F OBN C OBFLUSH C " of the 64 codons" RESET C
  3155 F AANOTE C
  3154 F 14 E CDSTART *
  CDTABLE B
:CDSTART
  20 2 GOTO C 29 SETFG C OBFLUSH C "ATG is also the START codon: proteins begin here." RESET C
:CDTABLE                   # the whole code, T C A G order, each codon in its own colour
  2 42 GOTO C GREY C OBFLUSH C "2nd base    T      C      A      G" RESET C
  0 3158 T
:CDTR
  3158 F 16 / CDTEND *
  3158 F 3 A 52 GOTO C
  0 3159 T
:CDTC
  OBROOM C
  3159 F 4 / CDTRN *
  3158 F 2 > TCAGIX C 16 M 3159 F TCAGIX C 4 M A 3158 F 3 P TCAGIX C A 3160 T
  3160 F CONTRAST C SETFG C 3160 F SETBG C
  3160 F 3154 F E CDTCUR *
  3160 F AAOF C 3155 F E CDTSYN *
  32 OBC C CDTCELL B
:CDTCUR
  62 OBC C CDTCELL B
:CDTSYN
  43 OBC C
:CDTCELL
  3160 F 4 > 3454 A F OBC C 3160 F 2 > 3 P 3454 A F OBC C 3160 F 3 P 3454 A F OBC C
  32 OBC C 3160 F AAOF C 3459 A F OBC C 32 OBC C
  RESET C 3159 PSTO CDTC B
:CDTRN
  3158 PSTO CDTR B
:CDTEND
  20 52 GOTO C GREY C OBFLUSH C "> this codon  + synonym" RESET C
  21 52 GOTO C GREY C OBFLUSH C "* = stop codon" RESET C
  23 2 GOTO C GREY C OBFLUSH C "colour = codon: 1st base red, 2nd green, 3rd blue  (A C G T = 0 85 170 255)" RESET C
  OBFLUSH C
  0 4145 T 2 TSYS C CDOUT J
  4149 F 1003 E CDNEXT *
  4149 F 1004 E CDPREV *
  4149 F 1002 E CDNEXT16 *
  4149 F 1001 E CDPREV16 *
:CDOUT
  FULLDRAW C R
:CDNEXT
  3069 F + 63 P 3069 T CARD B
:CDPREV
  3069 F 63 A 63 P 3069 T CARD B
:CDNEXT16
  3069 F 16 A 63 P 3069 T CARD B
:CDPREV16
  3069 F 48 A 63 P 3069 T CARD B
:RNAB                      # (base --)  as RNA: T is shown as U
  D 3 E RNAU *
  3454 A F OBC C R
:RNAU
  ! 85 OBC C R
:DNAB                      # (base --)
  3454 A F OBC C R
:GCB                       # (base -- 1 if C or G)
  D 1 E SWAP 2 E O R

# =====================================================================
#  help screen
# =====================================================================
:HELP
  RESET C ESC C  3549  OBS C 1 1 GOTO C
  BOLD C 56 SETFG C  3955  OBS C RESET C OBFLUSH C "  -  every colour is a codon, every codon is a colour"
  3 3 GOTO C BOLD C  3966  OBS C RESET C
  4 3 GOTO C OBFLUSH C "A C G T     type three bases to pick a colour: red, green, blue level"
  5 3 GOTO C OBFLUSH C "[  ]        previous / next colour       I   pick up the colour here"
  6 3 GOTO C OBFLUSH C "wheel       scroll through the colours   click the palette to choose"
  8 3 GOTO C BOLD C  3973  OBS C RESET C
  9 3 GOTO C OBFLUSH C "arrows      move (PgUp PgDn Home End: 8)    mouse: left paints, right picks"
  10 3 GOTO C OBFLUSH C "space       paint here                   P   pen down / up (paint as you move)"
  11 3 GOTO C OBFLUSH C "1 2 3 4     brush size                   *   spray"
  12 3 GOTO C OBFLUSH C "L R B O     line, rectangle, filled box, circle: press at one end,"
  13 3 GOTO C OBFLUSH C "            move, press again (or space).  Esc cancels"
  14 3 GOTO C OBFLUSH C "F           flood fill                   M   mirror: off, left-right, 4-way"
  15 3 GOTO C OBFLUSH C "Z           rainbow pen (colour steps every dab)    D   codon card: the biology"
  17 3 GOTO C BOLD C  3978  OBS C RESET C
  18 3 GOTO C OBFLUSH C "X           fill with a formula (8 of them, X again for the next)"
  19 3 GOTO C OBFLUSH C "V           shift every pixel to the next codon (hold it: animation)"
  21 3 GOTO C BOLD C  3984  OBS C RESET C
  22 3 GOTO C OBFLUSH C "S save .fa + .bmp    E open a .fa    U undo / redo    N new    Q quit"
  23 3 GOTO C OBFLUSH C "big .fa: arrows PgUp PgDn Home End wheel scroll  < > reading frame  K keep"
  24 3 GOTO C GREY C  3989  OBS C RESET C OBFLUSH C
  0 4145 T 2 TSYS C !
  FULLDRAW C R

