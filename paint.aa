# ---------------------------------------------------------------------
#  big FASTA viewer.  Standard FASTA has a header line, then lines of equal
#  width, so base number b sits at byte  header + b + (b / width) * eol.
#  VPROBE measures header, width and line ending once; VFILL then reads only
#  the 7200 bases on screen, straight from the file.
# ---------------------------------------------------------------------
:VSEEK                     # (offset --)  position the reader
  D 3128 T
  3124 F 4129 T 4130 T 0 4131 T 0 4132 T 13 FSYS C !
  0 3129 T 0 3130 T R
:RDB                       # ( -- byte, or -1 at the end)
  3130 F 3129 F L RDHAVE *
  3124 F 4129 T 1968 4130 T 512 4131 T 10 FSYS C RDEOF J
  4134 F D RDEOF0 J 3129 T 0 3130 T
:RDHAVE
  3130 F 1968 A F 3130 PSTO 3128 PSTO R
:RDEOF0
  !
:RDEOF
  0 1 S R
:VPROBE                    # sets $vh header bytes, $vw line width, $ve line-end bytes, $vn bases
  0 VSEEK C
  RDB C 62 = VPNOH *
:VPHDR
  RDB C D 0 L VPHEND *
  10 = VPHDR *
  VPHD2 B
:VPHEND
  !
:VPHD2
  3128 F 3131 T VPW B
:VPNOH
  0 3131 T 0 VSEEK C
:VPW
  0 3132 T 1 3133 T
:VPWL
  RDB C
  D 0 L VPWEND *
  D 10 E VPWEND *
  D 13 E VPCR *
  ! 3132 PSTO VPWL B
:VPCR
  ! 2 3133 T VPWD B
:VPWEND
  !
:VPWD
  3132 F 1 MAX 3132 T
  0 3134 T
  3123 F 1 L VPCOUNT *
  3123 F - VSEEK C RDB C 10 = VPCOUNT *
  3133 F 3134 T
:VPCOUNT                   # content = bases + (lines - 1) * eol  ->  bases
  3123 F 3131 F S 3134 F S 0 MAX 3135 T
  3135 F 3135 F 3132 F 3133 F A V 3133 F M S 3126 T R

:VFILL                     # the 2400 codons from base $vb onward -> canvas (4 pixels per cell)
  0 3044 T
:VFZ
  3044 F 600 / VFZE *
  0 3044 F 0 A T 3044 PSTO VFZ B
:VFZE
  3131 F 3125 F A 3125 F 3132 F V 3133 F M A VSEEK C
  0 3136 T 0 3137 T 0 3138 T 1 3139 T
  0 3140 T
:VFBLK                     # read a block; a 0 byte after it marks the end
  3136 F 2400 / VFDONE *
  3124 F 4129 T 1968 4130 T 512 4131 T 10 FSYS C VFDONE J
  4134 F D VFDONE0 J 1968 A D 3141 T 0 SWAP T 1968 3142 T
:VFBY                      # byte class: 0-3 base, 5 '>', 7 a 0 byte, 9 anything else
  3142 F F 3142 PSTO 127 P 2912 A F
  D 4 L VFBASE *
  D 7 E VFNUL *
  5 = VFBY *
:VFHDR                     # a header line inside the file: skip to its end
  3142 F F 3142 PSTO
  D VFHNUL J
  10 = VFHDR *
  VFBY B
:VFHNUL                    # a 0 byte in a header: end of block, or a real 0
  ! 3142 F 3141 F G VFHMORE *
  VFHDR B
:VFHMORE
  3124 F 4129 T 1968 4130 T 512 4131 T 10 FSYS C VFDONE J
  4134 F D VFDONE0 J 1968 A D 3141 T 0 SWAP T 1968 3142 T VFHDR B
:VFNUL                     # end of block (or a real 0 byte, skipped)
  ! 3142 F 3141 F G VFBLK *
  VFBY B
:VFBASE                    # (base 0..3 --)  $vcv starts at 1: after three bases it is >= 64
  3139 F 4 M A D 3139 T 64 L VFBY *
  3139 F 64 S 3137 F 6 M < 3138 F O 3138 T 1 3139 T 3136 PSTO
  3137 PSTO 3137 F 4 = VFCHK *
  3138 F 3140 F T 3140 PSTO 0 3137 T 0 3138 T
:VFCHK
  3136 F 2400 / VFDONE *
  VFBY B
:VFDONE0
  !
:VFDONE
  3137 F VFEND J
  3138 F 3140 F T
:VFEND
  ALLDIRTY C R

:BTINIT                    # byte -> class: a/A 0  c/C 1  g/G 2  t/T u/U 3,
  0 3044 T                   # other letters (N ...) and - . count as 0, > is 5, the rest 9
:BTLP
  3044 F 128 / BTEND *
  9 3044 F 2912 A T
  3044 F 32 O 97 L BTN *
  3044 F 32 O 122 G BTN *
  0 3044 F 2912 A T
:BTN
  3044 PSTO BTLP B
:BTEND
  0 45 2912 A T 0 46 2912 A T 5 62 2912 A T 7 2912 T
  1 99 2912 A T 2 103 2912 A T 3 116 2912 A T 3 117 2912 A T
  1 67 2912 A T 2 71 2912 A T 3 84 2912 A T 3 85 2912 A T R

:OBNC                      # (n --)  decimal with thousands commas
  D 1000 L OBNCS *
  D 1000 V OBNC C
  44 OBC C 1000 MOD
  D 100 V 48 A OBC C D 10 V 10 MOD 48 A OBC C 10 MOD 48 A OBC C R
:OBNCS
  OBN B

:VDELTA                    # (key -- delta 1 | 0 0)  scroll keys in the viewer
  D 1001 E VDU *
  D 1002 E VDD *
  D 1003 E VDR *
  D 1004 E VDL *
  D 1007 E VDPU *
  D 1008 E VDPD *
  D 2002 E VDWU *
  D 2003 E VDWD *
  D 60 E VDFL *
  D 44 E VDFL *
  D 62 E VDFR *
  D 46 E VDFR *
  ! 0 0 R
:VDU
  ! 0 180 S 1 R
:VDD
  ! 180 1 R
:VDR
  ! 3 1 R
:VDL
  ! 0 3 S 1 R
:VDPU
  ! 0 7200 S 1 R
:VDPD
  ! 7200 1 R
:VDWU
  ! 0 540 S 1 R
:VDWD
  ! 540 1 R
:VDFL
  ! 0 1 S 1 R
:VDFR
  ! 1 1 R

:VKEYS
  3143 F VDELTA C VKMOVE *
  !
  3143 F 1005 E VHOME *
  3143 F 1006 E VEND *
  3143 F 2000 E VCLICK *
  3143 F 75 E VKEEP *
  3143 F 27 E VKEEP *
  3143 F 69 E KLOAD *
  3143 F 83 E KSAVE *
  3143 F 72 E KHELP *
  3143 F 63 E KHELP *
  3143 F 68 E KCARD *
  3143 F 81 E KQUIT *
  3143 F 2001 E VKRET *
  MSG C OBFLUSH C "viewing a big file: K keeps this screen as a painting, then you can draw" R
:VKRET
  R
:VKMOVE                    # (delta)  plus every scroll key already waiting
  3144 T
:VDRAIN
  1 4145 T 2 TSYS C VAPPLY J
  4149 F VDELTA C VDMORE *
  ! 1 3145 T 4149 F 3146 T 4150 F 3147 T 4151 F 3148 T 4152 F 3149 T VAPPLY B
:VDMORE
  3144 F A 3144 T VDRAIN B
:VAPPLY                    # clamp to the file, keeping the reading frame
  3125 F 3144 F A 3150 T
:VCLAMP
  3150 F 0 L VCLO *
  3150 F 3127 F G VCHI *
  3150 F 3125 T VFILL C R
:VCLO
  3150 F 3 MOD 3125 T VFILL C R
:VCHI
  3127 F 3127 F 3150 F S 3 MOD S 3125 T VFILL C R
:VHOME
  3125 F 3 MOD 3125 T VFILL C R
:VEND                      # last screen, same reading frame
  3127 F 3125 F S 3 V + 3 M 3125 F A 3150 T VCLAMP B
:VCLICK
  3151 F 2 L VKRET *
  3151 F 61 G VKRET *
  3152 F 2 L VKRET *
  3152 F 21 G VKRET *
  3151 F 2 S 3152 F 2 S 2 M MOVETO C
  3066 F 3060 F GETPX C 3069 T
  MSG C  3875  OBS C 3060 F 60 M 3066 F A 3 M 3125 F A + OBNC C
   3881  OBS C 3069 F AAINFO C R
:VKEEP
  VCLOSE C 1 3051 T FULLDRAW C
  MSG C OBFLUSH C "this screen is now your painting - draw away (E opens the file again)" R

:VPANEL                    # viewer info and a scrollbar on the canvas edge
  16 64 TG C GREY C  3884  OBS C RESET C 2864 OBS C 10 OBSP C
  17 64 TG C GREY C  3892  OBS C 8 OBSP C
  18 64 TG C 2 OBSP C RESET C 3125 F + OBNC C 6 OBSP C
  19 64 TG C GREY C  3902  OBS C RESET C 3126 F OBNC C 6 OBSP C
  20 64 TG C GREY C  3906  OBS C RESET C 3125 F 3 MOD + OBN C 3 OBSP C
  3125 F 100 M 3127 F 1 MAX V 100 MIN OBN C 37 OBC C 4 OBSP C
  21 64 TG C GREY C  3914  OBS C RESET C
  0 3044 T
:VSBLP
  3044 F 20 / VSBEND *
  3044 F 2 A 62 GOTO C
  3125 F 19 M 3127 F 1 MAX V 3044 F E VSBTH *
  GREY C 3510 OBS C RESET C 3044 PSTO VSBLP B
