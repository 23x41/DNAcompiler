# =====================================================================
#  help screen
# =====================================================================
:HELP
  RESET C ESC C  3325  OBS C 1 1 GOTO C
  BOLD C 56 SETFG C  3643  OBS C RESET C OBFLUSH C "  -  every colour is a codon, every codon is a colour"
  3 3 GOTO C BOLD C  3654  OBS C RESET C
  4 3 GOTO C OBFLUSH C "A C G T     type three bases to pick a colour: red, green, blue level"
  5 3 GOTO C OBFLUSH C "[  ]        previous / next colour       I   pick up the colour here"
  6 3 GOTO C OBFLUSH C "wheel       scroll through the colours   click the palette to choose"
  8 3 GOTO C BOLD C  3661  OBS C RESET C
  9 3 GOTO C OBFLUSH C "arrows      move (PgUp PgDn Home End: 8)    mouse: left paints, right picks"
  10 3 GOTO C OBFLUSH C "space       paint here                   P   pen down / up (paint as you move)"
  11 3 GOTO C OBFLUSH C "1 2 3 4     brush size                   *   spray"
  12 3 GOTO C OBFLUSH C "L R B O     line, rectangle, filled box, circle: press at one end,"
  13 3 GOTO C OBFLUSH C "            move, press again (or space).  Esc cancels"
  14 3 GOTO C OBFLUSH C "F           flood fill                   M   mirror: off, left-right, 4-way"
  15 3 GOTO C OBFLUSH C "Z           rainbow pen (colour steps every dab)"
  17 3 GOTO C BOLD C  3666  OBS C RESET C
  18 3 GOTO C OBFLUSH C "X           fill with a formula (8 of them, X again for the next)"
  19 3 GOTO C OBFLUSH C "V           shift every pixel to the next codon (hold it: animation)"
  21 3 GOTO C BOLD C  3672  OBS C RESET C
  22 3 GOTO C OBFLUSH C "S save .fa + .bmp    E open a .fa    U undo / redo    N new    Q quit"
  24 3 GOTO C GREY C  3677  OBS C RESET C OBFLUSH C
  0 4145 T 2 TSYS C !
  FULLDRAW C R

