  2 42 GOTO C GREY C OBFLUSH C "2nd base    T      C      A      G" RESET C
  0 24314 T
:CDTR
  24314 F 16 / CDTEND *
  24314 F 3 A 52 GOTO C
  0 24315 T
:CDTC
