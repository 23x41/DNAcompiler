# =====================================================================
# paint.aa  --  GATC PAINT: a 64-colour pixel painter for the GATC VM
#
#   python3 GATCnux.py run paint.aa --no-banner --tty --fs --max-steps 2000000000
#
# 64 codons = 64 colours.  A codon's three bases are its red, green and blue
# levels (A 0, C 85, G 170, T 255), so the colour number is the codon's own
# 6-bit value - and every colour is also one of the VM's 64 instructions.
# Type three bases (e.g. G C A) to pick a colour.
#
# Two resolutions, set separately:
#   picture  W x H  the image itself, 1x1 .. 1024x1024 (what .fa / .bmp save)
#   screen   W x H  the drawing area on the terminal, in screen pixels
#                   (one character = 1 pixel wide, 2 tall), up to what fits
# "fit" stretches the picture over the screen, each axis on its own;
# "1:1" shows it at true size and scrolls.  A FASTA file is read once into
# memory, so changing the picture width re-wraps the DNA instantly - repeats
# whose period matches the width line up into stripes.
#
# Pixels live in the VM's file-backed byte space (FETCH/STORE at 65536+),
# one byte per pixel, so pictures are not limited by the 64K cells of RAM.
# Needs GATCnux.py 4.4 or later (--tty; --fs for saving and loading).
#
# Generated from paint.tpl by gen_aa.py.  No negative literals (DNA-safe).
# Memory map (generated):
#       0.. 4095  OB
#    4160..20159  FSTACK
#   20160..23239  SCAN
#   23240..23287  NB
#   23288..23351  PATH
#   23352..23415  XT
#   23416..23463  VNAME
#   23464..23591  BT
#   23592..23639  HDR
#   23640..23663  SB
#   23664..23743  PB
#   23744..23935  CB
#   23936..24127  BGRT
#   24128..24329  variables (202)
#   strings (119);  free: 0 low + 39671 high cells   (4096..4159 = device cells)
# =====================================================================





MAIN B

# =====================================================================
#  bridges
# =====================================================================
:TSYS                      # (cmd -- status)
  4144 T 4148 F R
:FSYS                      # (cmd -- status)
  4128 T 4133 F R

# =====================================================================
#  output buffer: everything on screen goes through OB, one write per frame
#  ($obfd = 0: the terminal, else a file handle from the fs bridge)
# =====================================================================
:OBC                       # (byte --)  no bounds check: callers use OBROOM
  24128 F T 24128 PSTO R
:OBROOM                    # make sure there is room for ~60 more bytes
  24128 F 0 S 3000 L OBRR *
  OBFLUSH B
:OBRR
  R
:OBFLUSH
  24128 F 0 S D OBFZ J
  24129 F OBFILE *
  0 4145 T 4146 T 3 TSYS C !
  0 24128 T R
:OBFILE
  0 4130 T 4131 T 24129 F 4129 T 11 FSYS C !
  0 24128 T R
:OBFZ
  ! R
:OBS                       # (addr --)  append a NUL-terminated string
  OBROOM C
:OBSLP
  D F OBSEND J
  D F OBC C + OBSLP B
:OBSEND
  ! R
:OBN                       # (n --)  decimal
  D 10 L OBN1 *
  D 10 V OBN C
  10 MOD
:OBN1
  48 A OBC C R
:OBSP                      # (k --)  k spaces
  D 1 L OBSPE *
  32 OBC C - OBSP B
:OBSPE
  ! R
:ESC                       # ESC [
  27 OBC C 91 OBC C R
:GOTO                      # (row col --)
  SWAP ESC C OBN C 59 OBC C OBN C 72 OBC C R
:RESET                     # plain colours
  ESC C 48 OBC C 109 OBC C 999 24130 T 999 24131 T R
:TG                        # (row col --)  move there with plain colours
  GOTO C RESET C R
:XTOUT                     # (colour --)  its xterm number, 2 or 3 digits
  23352 A F
  D 100 L XT2 *
  D 100 V 48 A 24128 F T 24128 PSTO
:XT2
  D 10 V 10 MOD 48 A 24128 F T 24128 PSTO 10 MOD 48 A 24128 F T 24128 PSTO R
:FG5                       # "38;5;"
  51 24128 F T 24128 PSTO 56 24128 F T 24128 PSTO 59 24128 F T 24128 PSTO 53 24128 F T 24128 PSTO 59 24128 F T 24128 PSTO R
:BG5                       # "48;5;"
  52 24128 F T 24128 PSTO 56 24128 F T 24128 PSTO 59 24128 F T 24128 PSTO 53 24128 F T 24128 PSTO 59 24128 F T 24128 PSTO R
:SETFG                     # (colour --)  only emitted when it changes
  D 24130 F E SFSAME *
  D 24130 T
  27 24128 F T 24128 PSTO 91 24128 F T 24128 PSTO FG5 C XTOUT C 109 24128 F T 24128 PSTO R
:SFSAME
  ! R
:SETBG
  D 24131 F E SFSAME *
  D 24131 T
  27 24128 F T 24128 PSTO 91 24128 F T 24128 PSTO BG5 C XTOUT C 109 24128 F T 24128 PSTO R
:COLORS                    # (fg bg --)  one escape for whatever changed
  D 24131 F E CLBGSAME *
  OVER 24130 F E CLFGSAME *
  D 24131 T OVER 24130 T
  27 24128 F T 24128 PSTO 91 24128 F T 24128 PSTO SWAP FG5 C XTOUT C 59 24128 F T 24128 PSTO BG5 C XTOUT C 109 24128 F T 24128 PSTO R
:CLFGSAME
  NIP SETBG B
:CLBGSAME
  ! SETFG B
:GREY                      # dim grey text
  ESC C  24679  OBS C 999 24130 T 999 24131 T R
:BOLD
  ESC C  24691  OBS C R

# =====================================================================
#  colours
# =====================================================================
:XTINIT                    # colour -> xterm-256 index (levels 0 95 175 255)
  0 24132 T
:XTLP
  24132 F 64 / XTEND *
  24132 F 4 > LV C 36 M
  24132 F 2 > 3 P LV C 6 M A
  24132 F 3 P LV C A 16 A
  24132 F 23352 A T
  24132 PSTO XTLP B
:XTEND
  R
:LV                        # (0..3 -- 0 1 3 5)
  D 2 / LVHI *
  R
:LVHI
  D A - R

:CONTRAST                  # (colour -- black or white)
  D 4 > 2 M OVER 2 > 3 P 5 M A SWAP 3 P A
  12 / CTBLK *
  63 R
:CTBLK
  0 R

:CODON                     # (colour --)  three base letters, each in its own hue
  24133 T
  24133 F 4 > BASEOUT C
  24133 F 2 > 3 P BASEOUT C
  24133 F 3 P BASEOUT C R
:BASEOUT                   # (base --)
  D BASECOL C SETFG C
  24611 A F OBC C R
:BASECOL                   # (base -- colour)  A blue CCT, C amber TGA, G green CTC, T coral TCC
  D BCA J
  D 1 E BCC *
  D 2 E BCG *
  ! 53 R
:BCA
  ! 23 R
:BCC
  ! 56 R
:BCG
  ! 29 R

:OPNAME                    # (colour --)  the instruction this codon encodes
  24330 SWAP
:ONLP
  D ONGO J
  SWAP
:ONSKIP
  D F 32 = ONNEXT1 *
  + SWAP - ONLP B
:ONNEXT1
  + ONSKIP B
:ONGO
  !
:ONPR
  D F D 32 = OVER BOOL P ONPC *
  ] R
:ONPC
  OBC C + ONPR B

:HEXRGB                    # (colour --)  #RRGGBB
  35 OBC C
  D 4 > HEX85 C D 2 > 3 P HEX85 C 3 P HEX85 C R
:HEX85                     # (level --)  00 55 AA FF
  D HX0 J
  D 1 E HX5 *
  D 2 E HXA *
  !  24694  OBS C R
:HX0
  !  24697  OBS C R
:HX5
  !  24700  OBS C R
:HXA
  !  24703  OBS C R


# =====================================================================
#  the picture: W x H bytes at PIX (file offset 16), header at offsets 0-3
#  file layout: 0 header | 16 picture (up to 1 MiB) | SCROFF scratch | SEQOFF DNA
# =====================================================================
:HSET                      # (a1 a2 a3 --)  arguments for a bulk command
  4106 T 4098 T 4097 T R
:HOST                      # (cmd -- status)
  4096 T 4102 F R
:SNAPN                     # (len --)  undo step: one copy of file[0, len)
  0 SWAP 0 HSET C 12 HOST C ! R
:SNAP                      # undo step for the picture as it is now
  24134 F 16 A SNAPN B
:DSNAP                     # undo step before drawing: the picture stops being "the file"
  SNAP C 0 24135 T R
:SETNP
  24136 F 24137 F M 24134 T R
:WRITEHDR
  24136 F 8 > 65536 T 24136 F 255 P 65536 + T
  24137 F 8 > 65536 2 A T 24137 F 255 P 65536 3 A T R
:READHDR                   # ( -- changed)  picture size from the header (after undo / redo)
  65536 F 8 < 65536 + F O 24138 T
  65536 2 A F 8 < 65536 3 A F O 24139 T
  24138 F 24136 F = 24139 F 24137 F = O
  24138 F 1 MAX 24136 T 24139 F 1 MAX 24137 T SETNP C R

:GETPX                     # (x y -- colour)
  24136 F M A 65552 A F R
:SETPX                     # (colour x y --)  ignores points outside the picture
  24140 T 24141 T
  24141 F 0 L SPXOUT *
  24141 F 24136 F / SPXOUT *
  24140 F 0 L SPXOUT *
  24140 F 24137 F / SPXOUT *
  24140 F 24136 F M 24141 F A 65552 A T
  1 24142 T
  24140 F PXDIRTY B
:SPXOUT
  ! R
:PXDIRTY                   # (picture row --)  mark the screen rows that show it
  24143 F S D 0 L PXDNO *
  D 24144 F M 24145 F A - 24145 F V 24146 T
  + 24144 F M 24145 F A - 24145 F V - 24146 F MAX
  2 V DIRTY C 24146 F 2 V DIRTY B
:PXDNO
  ! R
:DIRTY                     # (screen row --)
  D 24147 F MIN 24147 T 24148 F MAX 24148 T R
:ALLDIRTY
  0 24147 T 24149 F - 24148 T R

# =====================================================================
#  layout: screen size, terminal size, picture -> screen mapping
#  a screen pixel (sx, h) shows picture pixel
#     (vx + sx * mxn / mxd,  vy + h * myn / myd)
#  fit: mxn/mxd = W/screen width, myn/myd = H/screen height;  1:1: 1/1
# =====================================================================
:TERMSIZE                  # $tc $tr, and the biggest screen that fits: $maxw $maxh
  4 TSYS C ! 4149 F 40 MAX 24150 T 4150 F 12 MAX 24151 T
  24150 F 20 S 24152 T 24151 F 4 S 2 M 24153 T R
:LAYOUT
  TERMSIZE C
  24154 F 24152 F MIN 24155 T 24156 F 24153 F MIN 24157 T
  24158 F LYFIT *
  24155 F 24136 F MIN 24155 T 24157 F 24137 F MIN 24157 T
  1 24159 T 1 24160 T 1 24145 T 1 24144 T
  CLAMPV C LYDONE B
:LYFIT
  0 24161 T 0 24143 T
  24136 F 24159 T 24155 F 24160 T 24137 F 24145 T 24157 F 24144 T
:LYDONE
  24159 F 24160 F V 24162 T 24159 F 24160 F MOD 24163 T
  24155 F 24164 T 24157 F + 2 V 24149 T
  24164 F 4 A 24165 T
  24149 F 3 A 23 MAX 24151 F - MIN 24166 T 24166 F + 24167 T
  24168 F 24136 F - MIN 24168 T 24169 F 24137 F - MIN 24169 T
  24170 F 24136 F - MIN 24170 T 24171 F 24137 F - MIN 24171 T R
:CLAMPV                    # keep the 1:1 view inside the picture
  24161 F 24136 F 24155 F S MIN 0 MAX 24161 T
  24143 F 24137 F 24157 F S MIN 0 MAX 24143 T R
:FOLLOW                    # 1:1: scroll so the cursor stays on screen
  24158 F FORET *
  24161 F 24172 T 24143 F 24173 T
  24168 F 24161 F L FOX *
  24168 F 24161 F 24155 F A L FOY *
:FOX
  24168 F 24155 F 2 V S 24161 T
:FOY
  24169 F 24143 F L FOY2 *
  24169 F 24143 F 24157 F A L FOCL *
:FOY2
  24169 F 24157 F 2 V S 24143 T
:FOCL
  CLAMPV C
  24161 F 24172 F = 24143 F 24173 F = O FORET J
  ALLDIRTY C
:FORET
  R
:CURCELL                   # screen cells of the cursor and the anchor (for shrunk pictures)
  24168 F 24161 F S 24160 F M 24159 F A - 24159 F V 24174 T
  24169 F 24143 F S 24144 F M 24145 F A - 24145 F V 24175 T
  24170 F 24161 F S 24160 F M 24159 F A - 24159 F V 24176 T
  24171 F 24143 F S 24144 F M 24145 F A - 24145 F V 24177 T R

