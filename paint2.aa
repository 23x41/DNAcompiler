# =====================================================================
#  help screen
# =====================================================================
:HELP
  RESET C ESC C  24706  OBS C 1 1 GOTO C
  BOLD C 56 SETFG C  25693  OBS C RESET C OBFLUSH C "  -  every colour is a codon, every codon is a colour"
  3 3 GOTO C BOLD C  25704  OBS C RESET C
  OBFLUSH C "  A C G T: type three bases   [ ] prev/next   I pick up   click palette"
  4 3 GOTO C BOLD C  25711  OBS C RESET C
  OBFLUSH C "    arrows move (PgUp PgDn Home End: 8)   space paint   mouse: left paints"
  5 3 GOTO C OBFLUSH C "        right button picks a colour   P pen down/up   1-9 brush size   * spray"
  6 3 GOTO C OBFLUSH C "        L R B O  line, rectangle, filled box, circle: press at one end, move,"
  7 3 GOTO C OBFLUSH C "        press again (or space)  F fill  M mirror  Z rainbow pen  Esc cancel"
  9 3 GOTO C BOLD C  25716  OBS C RESET C
  OBFLUSH C "   picture = the image (what is saved).  screen = the drawing area here."
  10 3 GOTO C OBFLUSH C "        W  picture size: Enter/Tab re-wrap (keep the pixel sequence) or"
  11 3 GOTO C OBFLUSH C "           crop/pad (keep x,y)     ( )  picture width - 1 / + 1, re-wrapped"
  12 3 GOTO C OBFLUSH C "        #  screen size (Tab: the biggest that fits; zoom the terminal out)"
  13 3 GOTO C OBFLUSH C "        0  fit (stretch the picture over the screen) / 1:1 (true size, scroll)"
  14 3 GOTO C OBFLUSH C "        N  new blank picture of any size, up to 1024x1024"
  16 3 GOTO C BOLD C  25722  OBS C RESET C
  OBFLUSH C "   X fill with a formula (8 of them)   V every pixel to the next codon"
  18 3 GOTO C BOLD C  25728  OBS C RESET C
  OBFLUSH C "     E open a .fa at any size   ( ) re-wraps it: repeats line up as stripes"
  19 3 GOTO C OBFLUSH C "        longer than the picture: arrows PgUp PgDn scroll  < > frame  K keep"
  20 3 GOTO C OBFLUSH C "        D codon card: the biology of the current colour"
  22 3 GOTO C BOLD C  25732  OBS C RESET C
  OBFLUSH C "    S save .fa + .bmp   U undo   Y redo   Q quit"
  24 3 GOTO C GREY C  25737  OBS C RESET C OBFLUSH C
  0 4145 T 2 TSYS C !
  FULLDRAW C R

