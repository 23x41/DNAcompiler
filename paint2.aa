  12 2 GOTO C GREY C OBFLUSH C "mass            " RESET C 24311 F AAMASS C
  13 2 GOTO C GREY C OBFLUSH C "essential       " RESET C 24311 F AAESS C
  14 2 GOTO C GREY C OBFLUSH C "codons          " RESET C
  0 24312 T 0 24313 T
:CDSYN                     # every codon for the same amino acid
  OBROOM C
  24313 F 64 / CDSYND *
