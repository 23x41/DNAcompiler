# =====================================================================
# sak.aa  --  GATC SAK: a swiss army knife shell for the GATC VM
#
#   python3 GATCloader.py run sak.aa --no-banner --fs --max-steps 2000000000
#   python3 GATCloader.py run sak.aa --no-banner --fs-root ~/sandbox --max-steps 2000000000
#   echo "ls -l" | python3 GATCloader.py run sak.aa --no-banner --fs
#
# Commands:  ls ll cd pwd cat touch cp mv rm mkdir rmdir ln stat chmod echo
#            head tail wc grep xxd find tree du df crc32 realpath date whoami
#            clear help exit
# Shell:     "quotes" 'quotes' and \escapes, wildcards * and ? in the last part
#            of a path, output redirection with > file and >> file.
#
# The VM has no file-system opcodes, so GATCloader.py --fs provides small
# syscall-like steps through control cells 4128..4138 (stat, opendir, open,
# read, write, unlink, rename ...).  Everything else - parsing, globbing, the
# recursive directory walker, ls columns, dates, grep, wc, tail, xxd, crc32 -
# is done here in GATC assembly.
#
# Generated from sak.tpl by gen_sak.py (addresses are assigned automatically).
# No negative literals are used (bytecode/DNA decoding reads immediates unsigned).
# Memory map (generated):
#       0..  255  LINE
#     256..  543  ARGBUF
#     544..  575  ARGV
#     576..  607  OPND
#     608.. 1207  PA
#    1208.. 1807  PB
#    1808.. 2319  BLK
#    2320.. 2575  NAME
#    2576.. 2831  LBUF
#    2832.. 2959  PAT
#    2960.. 3055  GPAT
#    3056.. 3119  EBUF
#    3120.. 3469  FRAMES
#    3470.. 3687  variables (218)
#    3688.. 3929  strings (48)   free: 166 cells
# =====================================================================




MAIN B

# =====================================================================
#  host bridge
# =====================================================================

:SYS                       # (cmd -- status)
  4128 T 4133 F R
:ERRB                      # following output goes to stderr
  1 4129 T 25 SYS C ! R
:ERRE                      # back to stdout (or the redirect file)
  0 4129 T 25 SYS C ! R
:STATP                     # (path follow -- ok)  sets $ssize $stype $smode $smtime
  4130 T 4129 T 1 SYS C D STPF J
  4134 F 3470 T 4135 F 3471 T 4136 F 3472 T 4137 F 3473 T
:STPF
  R
:FOPEN                     # (path mode -- ok)  handle in %FR1
  4130 T 4129 T 9 SYS C R
:FCLOSE                    # (fd --)
  4129 T 12 SYS C ! R
:BREAD                     # (fd -- n)  read up to 512 bytes into BLK, 0 at EOF or error
  4129 T 1808 4130 T 512 4131 T 10 SYS C BRFAIL J
  4134 F R
:BRFAIL
  0 R
:FSEEK                     # (fd offset --)  absolute position
  4130 T 4129 T 0 4131 T 0 4132 T 13 SYS C ! R
:SAMEF                     # (a b -- same)  %FR2 = b is inside a
  4130 T 4129 T 24 SYS C ! 4134 F R
:TTYCHK
  21 SYS C ! 4134 F 3474 T 4135 F 3475 T 4136 F 3476 T R
:TIMEINIT
  18 SYS C ! 4134 F 3477 T 4135 F 3478 T R

# =====================================================================
#  strings
# =====================================================================

:STRLEN                    # (a -- n)
  D
:SLLP
  D F SLEND J
  + SLLP B
:SLEND
  SWAP S R

:STREQ                     # (a b -- flag)
  3479 T 3480 T
:SQLP
  3479 F F 3480 F F = SQNO *
  3479 F F SQYES J
  3479 PSTO 3480 PSTO SQLP B
:SQNO
  0 R
:SQYES
  1 R

:STRNCPY                   # (src dst max --)  copy at most max-1 bytes; $ctr = 1 if cut
  - 3481 T 3482 T 3483 T 0 3484 T
:SNLP
  3483 F F D SNEND J
  3481 F SNFULL J
  3482 F T
  3483 PSTO 3482 PSTO 3481 F - 3481 T
  SNLP B
:SNFULL
  1 3484 T
:SNEND
  ! 0 3482 F T R

:APPENDS                   # (src dst max -- ok)  append src to the string at dst
  3485 T 3486 T 3487 T
  3486 F STRLEN C 3488 T
  3487 F 3486 F 3488 F A 3485 F 3488 F S STRNCPY C
  3484 F N R

:PATHJOIN                  # (src buf -- ok)  buf = buf "/" src  (no doubled slash)
  3489 T 3490 T
  3489 F STRLEN C D PJNOSL J
  - 3489 F A F 47 E PJCAT *
  3850 3489 F 600 APPENDS C PJFAIL J
  PJCAT B
:PJNOSL
  !
:PJCAT
  3490 F 3489 F 600 APPENDS C R
:PJFAIL
  0 R

:ADDNAME                   # (buf -- ok)  buf = buf "/" NAME
  2320 SWAP PATHJOIN C R

:BASENAME                  # (p -- q)  q = text after the last '/'
  D 3491 T
:BNLP
  D F BNEND J
  D F 47 E BNSL *
  + BNLP B
:BNSL
  + D 3491 T BNLP B
:BNEND
  ! 3491 F R

:HASWILD                   # (p -- flag)  contains * or ?
:HWLP
  D F D HWNO J
  D 42 E SWAP 63 E O HWYES *
  + HWLP B
:HWNO
  ] 0 R
:HWYES
  ! 1 R

:STRIPSL                   # (buf --)  drop trailing slashes, keep a lone "/"
  3492 T
:SSLP
  3492 F STRLEN C D 2 L SSDONE *
  - 3492 F A D F 47 = SSDONE *
  0 SWAP T SSLP B
:SSDONE
  ! R

:LOWER                     # (c -- c')
  D 65 L LWX *
  D 90 G LWX *
  32 O
:LWX
  R

:LOWERBUF                  # (buf --)
:LBLP
  D F LBEND J
  D F LOWER C OVER T + LBLP B
:LBEND
  ! R

:PARSENUM                  # (p -- n)  decimal; $nbad = 1 if empty or trailing junk
  3493 T 0 3494 T 0 3495 T
:PNLP
  3493 F F D 48 L OVER 57 G O PNEND *
  48 S 3494 F 10 M A 3494 T 3493 PSTO 3495 PSTO PNLP B
:PNEND
  3495 F N SWAP BOOL O 3496 T 3494 F R

:WMATCH                    # (pat str -- flag)  wildcard match: * any run, ? one byte
  3497 T 3498 T
  0 3499 T 0 3500 T 0 3501 T 0 3502 T
:WMLP
  3500 F 3497 F A F WMTAIL J
  3499 F 3498 F A F 3503 T
  3503 F 63 E WMADV *
  3503 F 42 E WMSTAR *
  3503 F 3500 F 3497 F A F E WMADV *
  3501 F WMNO J
  3501 F 3499 T 3502 PSTO 3502 F 3500 T WMLP B
:WMADV
  3499 PSTO 3500 PSTO WMLP B
:WMSTAR
  3499 F + D 3501 T 3499 T 3500 F 3502 T WMLP B
:WMTAIL
  3499 F 3498 F A F 42 = WMEND *
  3499 PSTO WMTAIL B
:WMEND
  3499 F 3498 F A F N R
:WMNO
  0 R

# =====================================================================
#  output
# =====================================================================

:WRITEN                    # (a n --)  raw bytes to stdout (UTF-8 safe, byte exact)
  D WNZ J
  4131 T 4130 T 1 4129 T 11 SYS C ! R
:WNZ
  ] R
:PUTS                      # (a --)
  D STRLEN C WRITEN C R

:SPACES                    # (k --)
  D 1 L SPEND *
  32 W - SPACES B
:SPEND
  ! R

:NUMW                      # (n -- digits)
  1 SWAP
:NWLP
  D 10 L NWEND *
  10 V SWAP + SWAP NWLP B
:NWEND
  ! R

:PADNUM                    # (n width --)  right aligned
  OVER NUMW C S SPACES C Y R

:PAD2                      # (n --)  two digits
  D 10 L P2Z *
  Y R
:P2Z
  48 W Y R

:HEXN                      # (n digits --)
  3504 T 3505 T
:HXLP
  3504 F HXEND J
  3504 F - D 3504 T 4 M 3505 F SWAP > 15 P
  D 10 L HXNUM *
  87 A W HXLP B
:HXNUM
  48 A W HXLP B
:HXEND
  R

:OCT4                      # (n --)  4 octal digits
  D 9 > 7 P Y D 6 > 7 P Y D 3 > 7 P Y 7 P Y R

:HUMAN                     # (n width --)  1023, 4.0K, 12M ... right aligned
  3506 T 3507 T
  3507 F 1024 L HUPLAIN *
  0 3508 T 1024 3509 T
:HULP
  3507 F 3509 F 1024 M L HUGO *
  3508 F 4 / HUGO *
  3509 F 1024 M 3509 T 3508 PSTO HULP B
:HUGO                      # rounds up, like GNU ls/du/df -h
  3507 F 10 M 3509 F A - 3509 F V 3510 T
  3510 F 100 L HUDEC *
  3507 F 3509 F A - 3509 F V
  D 1024 L HUINT *
  ! 10 3510 T 3509 F 1024 M 3509 T 3508 PSTO HUDEC B
:HUINT
  D NUMW C + 3506 F SWAP S SPACES C Y HUUNIT C R
:HUDEC
  3510 F 10 V NUMW C 3 A 3506 F SWAP S SPACES C
  3510 F 10 V Y 46 W 3510 F 10 MOD Y HUUNIT C R
:HUPLAIN
  3507 F 3506 F PADNUM C R
:HUUNIT
  3508 F
  D HUK J
  D 1 E HUM *
  D 2 E HUG *
  D 3 E HUT *
  ! 80 W R
:HUK
  ! 75 W R
:HUM
  ! 77 W R
:HUG
  ! 71 W R
:HUT
  ! 84 W R

:PERMS                     # (mode --)  rwxr-xr-x
  3511 T 8 3512 T
:PMLP
  3511 F 3512 F > 1 P
  3512 F 3 MOD
  SWAP PMDASH J
  D 2 E PMR *
  D 1 E PMW *
  ! 120 W PMNX B
:PMR
  ! 114 W PMNX B
:PMW
  ! 119 W PMNX B
:PMDASH
  ! 45 W
:PMNX
  3512 F PMEND J
  3512 F - 3512 T PMLP B
:PMEND
  R

:TYPECH                    # (type --)
  D 2 E TCD *
  D 3 E TCL *
  ! 45 W R
:TCD
  ! 100 W R
:TCL
  ! 108 W R

# civil date from a unix time (Howard Hinnant's days-to-civil), local time via $tzoff
:DATEFMT                   # (t --)  YYYY-MM-DD HH:MM[:SS]
  3478 F A
  D 0 L DFNEG *
:DFGO
  D 86400 V 3513 T 86400 MOD 3514 T
  3513 F 719468 A 3515 T
  3515 F 146097 V 3516 T
  3515 F 3516 F 146097 M S 3517 T
  3517 F 3517 F 1460 V S 3517 F 36524 V A 3517 F 146096 V S 365 V 3518 T
  3518 F 3516 F 400 M A 3519 T
  3517 F 3518 F 365 M 3518 F 4 V A 3518 F 100 V S S 3520 T
  3520 F 5 M 2 A 153 V 3521 T
  3520 F 3521 F 153 M 2 A 5 V S + 3522 T
  3521 F 10 L DFM1 *
  3521 F 9 S 3523 T DFM2 B
:DFM1
  3521 F 3 A 3523 T
:DFM2
  3523 F 2 ^ 3519 F A 3519 T
  3519 F Y 45 W 3523 F PAD2 C 45 W 3522 F PAD2 C
  32 W 3514 F 3600 V PAD2 C 58 W 3514 F 60 V 60 MOD PAD2 C
  3524 F DFRET J
  58 W 3514 F 60 MOD PAD2 C
:DFRET
  R
:DFNEG
  ! 0 DFGO B

# colours (only when stdout is a terminal)
:CRED
  3474 F CX1 J 27 W "[1;31m"
:CX1
  R
:CGRN
  3474 F CX2 J 27 W "[32m"
:CX2
  R
:CMAG
  3474 F CX3 J 27 W "[35m"
:CX3
  R
:CBLU
  3474 F CX4 J 27 W "[1;34m"
:CX4
  R
:CYEL
  3474 F CX5 J 27 W "[1;33m"
:CX5
  R
:CRST
  3474 F CX6 J 27 W "[0m"
:CX6
  R

:NAMECOL                   # (addr --)  print a name coloured by $etype / $emode
  3474 F NCPLAIN J
  3525 F 2 E NCDIR *
  3525 F 3 E NCLNK *
  3525 F 1 E 3526 F 73 P BOOL P NCEXE *
:NCPLAIN
  SAFEPUTS C R
:NCDIR
  27 W "[1;34m" NCGO B
:NCLNK
  27 W "[1;36m" NCGO B
:NCEXE
  27 W "[1;32m"
:NCGO
  SAFEPUTS C 27 W "[0m" R

:SAFEPUTS                  # (a --)  like PUTS, but control bytes show as ? on a terminal
  3474 F PUTS J
  D 3527 T
:SPSCAN
  D F D SPLAST J
  D 32 L SWAP 127 E O SPCTL *
  + SPSCAN B
:SPLAST
  ! 3527 F S 3527 F SWAP WRITEN C R
:SPCTL
  D 3527 F S 3527 F SWAP WRITEN C 63 W + D 3527 T SPSCAN B

# errors:  "cmd: 'path': message"  on stderr
:EPRE
  ERRB C 3528 F PUTS C ": " R
:EEND
  CR ERRE C 1 3529 T R
:PERR                      # (errno --)
  4129 T 3056 4130 T 64 4131 T 19 SYS C ! 3056 PUTS C R
:EFAIL                     # (path errno --)
  3530 T 3531 T
  EPRE C "'" 3531 F PUTS C "': " 3530 F PERR C EEND C R
:MISSING
  EPRE C "missing operand (try: help)" EEND C R

:CLRSTK
  , CLRMORE *
  R
:CLRMORE
  ! CLRSTK B

# =====================================================================
#  line reader (UTF-8 encodes non-ASCII input) and tokenizer
# =====================================================================

:PUTLB                     # (b --)
  3532 F 255 / PLFULL *
  3532 F 0 A T
  3532 PSTO R
:PLFULL
  ! 1 3533 T R

:UTF8                      # (c --)  c >= 128
  D 2048 L U8TWO *
  D 65536 L U8THREE *
  D 18 > 240 O PUTLB C
  D 12 > 63 P 128 O PUTLB C
  D 6 > 63 P 128 O PUTLB C
  63 P 128 O PUTLB C R
:U8THREE
  D 12 > 224 O PUTLB C
  D 6 > 63 P 128 O PUTLB C
  63 P 128 O PUTLB C R
:U8TWO
  D 6 > 192 O PUTLB C
  63 P 128 O PUTLB C R

:READLINE                  # ( -- eof )
  0 3532 T 0 3533 T
:RLLP
  ?
  D 0 L RLEOF *
  D 10 E RLEOL *
  D 13 E RLSKIP *
  D RLSKIP J
  D 128 L RLASC *
  UTF8 C RLLP B
:RLASC
  PUTLB C RLLP B
:RLSKIP
  ! RLLP B
:RLEOL
  ! RLFIN B
:RLEOF
  !
  3532 F RLFIN *
  0 0 T 1 R
:RLFIN
  0 3532 F 0 A T
  3533 F RLWARN *
  0 R
:RLWARN
  ERRB C "sak: line cut to 255 bytes" CR ERRE C 0 R

:LCH                       # ( -- c )
  3534 F 0 A F R

:TOKENIZE                  # LINE -> ARGV/$argc, handles quotes, \x and > >> redirection
  0 3534 T 0 3535 T 0 3536 T
:TKNEXT
  LCH C
  D 32 E TKWS *
  D 9 E TKWS *
  D TKDONE J
  !
  3536 F 31 / TKFIN *
  3535 F 256 A 3536 F 544 A T
  3536 PSTO 0 3537 T
:TKCH
  LCH C
  D TKEND J
  3537 F TKINQ *
  D 32 E TKEND *
  D 9 E TKEND *
  D 34 E TKQOPEN *
  D 39 E TKQOPEN *
  D 92 E TKBSL *
  D 62 E TKGT *
  TKPUT C
:TKADV
  3534 PSTO TKCH B
:TKWS
  ! 3534 PSTO TKNEXT B
:TKDONE
  ! TKFIN B
:TKEND
  ! 0 TKPUT C TKNEXT B
:TKQOPEN
  3537 T 3534 PSTO TKCH B
:TKINQ
  D 3537 F E TKQCLOSE *
  TKPUT C TKADV B
:TKQCLOSE
  ! 0 3537 T TKADV B
:TKBSL
  ! 3534 PSTO LCH C D TKEND J
  TKPUT C TKADV B
:TKGT                      # unquoted > inside a word: split it off as its own word
  !
  3536 F - 544 A F 3535 F 256 A E TKGTSAME *
  0 TKPUT C
  3536 F 31 / TKFIN *
  3535 F 256 A 3536 F 544 A T 3536 PSTO
:TKGTSAME
  62 TKPUT C 3534 PSTO
  LCH C 62 = TKGTEND *
  62 TKPUT C 3534 PSTO
:TKGTEND
  0 TKPUT C TKNEXT B
:TKPUT                     # (c --)  the last ARGBUF cell is never written: always a NUL
  3535 F 287 / TKPFULL *
  3535 F 256 A T 3535 PSTO R
:TKPFULL
  ! R
:TKFIN
  0 3538 T 0 3539 T
:RDLP
  3539 F 3536 F / RDDONE *
  3539 F 544 A F
  D F 62 = RDNX *
  + D F 62 E RDAPP *
  1 3538 T RDTGT B
:RDAPP
  + 2 3538 T
:RDTGT
  D F RDHAVE *
  ! 3539 F + D 3536 F L RDNOTGT J
  544 A F
:RDHAVE
  3540 T
  3539 F 3536 T
  RDDONE B
:RDNX
  ! 3539 PSTO RDLP B
:RDNOTGT
  ! ERRB C "sak: missing file name after >" CR ERRE C
  0 3538 T 0 3536 T
:RDDONE
  R

# =====================================================================
#  options, operands and wildcards
# =====================================================================

# PREP: argv[1..] -> option bits ($opts, letter a..z), a number ($optnum/$hasnum from -20,
# -n20 or "-n 20" when $wantn = 1), operands -> OPND/$nop, $multi = several or wildcard.
:PREP
  0 3541 T 0 3542 T 0 3543 T 0 3544 T 0 3545 T 0 3546 T
  1 3547 T
:PPLP
  3547 F 3536 F / PPDONE *
  3547 F 544 A F 3548 T
  3545 F PPOPND *
  3548 F F 45 = PPOPND *
  3548 F + F PPOPND J
  3548 F + F 45 E PPDD *
  3548 F + 3548 T
:PPLET
  3548 F F D PPLEND J
  D 48 / OVER 57 ^ P PPDIG *
  LOWER C
  D 110 E 3549 F P PPNOPT *
  D 97 L PPBAD *
  D 122 G PPBAD *
  97 S ONE SWAP SHL 3541 F O 3541 T
  3548 PSTO PPLET B
:PPBAD
  ! EPRE C "ignoring unknown option in '" 3547 F 544 A F PUTS C "'" EEND C 0 3529 T
  3547 PSTO PPLP B
:PPDIG
  ! 3548 F PARSENUM C 3543 T 1 3542 T
  3547 PSTO PPLP B
:PPNOPT
  ! 3548 F + F PPNNEXT J
  3548 F + PARSENUM C 3543 T 1 3542 T
  3547 PSTO PPLP B
:PPNNEXT
  3547 PSTO 3547 F 3536 F / PPNMISS *
  3547 F 544 A F PARSENUM C 3543 T 1 3542 T
  3496 F PPNBAD *
  3547 PSTO PPLP B
:PPNBAD
  EPRE C "-n needs a number, not '" 3547 F 544 A F PUTS C "'" EEND C
  0 3542 T 3547 PSTO PPLP B
:PPNMISS
  EPRE C "-n needs a number" EEND C PPDONE B
:PPLEND
  ! 3547 PSTO PPLP B
:PPOPND
  3544 F 31 / PPSKIP *
  3548 F 3544 F 576 A T 3544 PSTO
  3548 F HASWILD C PPSKIP J
  1 3546 T
:PPSKIP
  3547 PSTO PPLP B
:PPDD
  3548 F 2 A F PPDDSET J
  EPRE C "ignoring unknown option '" 3548 F PUTS C "'" EEND C 0 3529 T
  3547 PSTO PPLP B
:PPDDSET
  1 3545 T 3547 PSTO PPLP B
:PPDONE
  3544 F 1 G 3546 F O 3546 T R

:OPT                       # (letter -- flag)
  97 S ONE SWAP SHL 3541 F P BOOL R
:OPTSET                    # (letter --)
  97 S ONE SWAP SHL 3541 F O 3541 T R

:SHIFTOP                   # drop the first operand
  0 3550 T
:SHLP
  3550 F + 3544 F / SHEND *
  3550 F + 576 A F 3550 F 576 A T 3550 PSTO SHLP B
:SHEND
  3544 F - 3544 T R

# FOREACH: for every operand put its path in PA and call the routine in $hand.
# Wildcards are expanded against the directory (sorted, dot-files only when the
# pattern starts with a dot).  No match: the word is passed on as it is, like a shell.
:FOREACH
  0 3551 T
:FELP
  3551 F 3544 F / FEDONE *
  3551 F 576 A F 3552 T
  3552 F HASWILD C FEWILD *
  3552 F 608 600 STRNCPY C
  3484 F FELONG *
  608 STRIPSL C
  3553 F C FENX B
:FEWILD
  EXPAND C FENX B
:FELONG
  3552 F 36 EFAIL C
:FENX
  3551 PSTO FELP B
:FEDONE
  R

:EXPAND
  3552 F D BASENAME C SWAP S 3554 T
  3552 F 3554 F A 2960 96 STRNCPY C
  3552 F 608 600 STRNCPY C
  0 3554 F 608 A T
  3554 F EXHAVE *
  3845 4129 T EXOPEN B
:EXHAVE
  608 4129 T
:EXOPEN
  2 SYS C EXLIT J
  4134 F 3555 T 4135 F 3556 T 0 3557 T 0 3558 T
:EXLP
  3557 F 3556 F / EXEND *
  3555 F 4129 T 3557 F 4130 T 2320 4131 T 256 4132 T 3 SYS C !
  2320 F 46 E 2960 F 46 = P EXSKIP *
  2960 2320 WMATCH C EXSKIP J
  0 3554 F 608 A T
  2320 608 600 APPENDS C EXSKIP J
  3558 PSTO
  3553 F C
:EXSKIP
  3557 PSTO EXLP B
:EXEND
  3555 F 4129 T 4 SYS C !
  3558 F EXRET *
:EXLIT
  3552 F 608 600 STRNCPY C 3553 F C
:EXRET
  R

# =====================================================================
#  recursive directory walker
#  PA (and PB when $wdual = 1) is the directory.  For every entry the walker appends
#  "/name" to PA (and PB) and calls  $wfile  for files, or  $wpre  (returns: descend?),
#  recurses, then  $wpost  for directories.  Entry data: $etype $emode $esize $elast.
#  Symbolic links are never followed.  Per-level state lives in FRAMES[depth*7 + k]:
#  0 handle  1 count  2 index  3 PA length  4 PB length  5 last visible index
#  6 size accumulator (du).  Up to 48 levels deep.
# =====================================================================

:FR                        # (k -- addr)
  3559 F 7 M A 3120 A R
:NOOP
  R
:RET1
  1 R

:WALK
  0 6 FR C T
  3559 F 48 / WKDEEP *
  608 4129 T 2 SYS C WKOPENF J
  4134 F 0 FR C T 4135 F 1 FR C T 0 2 FR C T
  608 STRLEN C 3 FR C T
  1208 STRLEN C 4 FR C T
  LASTVIS C 5 FR C T
:WKLP
  2 FR C F 1 FR C F / WKEND *
  2 FR C F WKENT C
  3560 F WKSHOW *
  2320 F 46 E WKNEXT *
:WKSHOW
  2 FR C F 5 FR C F E 3561 T
  608 ADDNAME C WKLONG J
  3562 F WKNOB J
  1208 ADDNAME C WKLONG J
:WKNOB
  3525 F 2 E WKDIR *
  3563 F C WKREST B
:WKDIR
  3564 F C WKREST J
  3559 PSTO WALK C 3559 F - 3559 T
  3565 F C
:WKREST
  0 3 FR C F 608 A T
  0 4 FR C F 1208 A T
:WKNEXT
  2 FR C PSTO WKLP B
:WKLONG
  0 3 FR C F 608 A T
  EPRE C "path too long under '" 608 PUTS C "'" EEND C
  WKREST B
:WKEND
  0 FR C F 4129 T 4 SYS C ! R
:WKOPENF
  608 4134 F EFAIL C R
:WKDEEP
  EPRE C "directory tree too deep at '" 608 PUTS C "'" EEND C R

:WKENT                     # (idx --)  entry of this level's directory -> NAME, $etype ...
  4130 T 0 FR C F 4129 T 2320 4131 T 256 4132 T 3 SYS C !
  4135 F 3525 T 4136 F 3526 T 4137 F 3566 T R

:LASTVIS                   # ( -- idx)  index of the last entry the walk will show
  1 FR C F 3567 T
:LVLP
  3567 F LVNONE J
  3567 F - D 3567 T WKENT C
  3560 F LVHIT *
  2320 F 46 = LVHIT *
  LVLP B
:LVHIT
  3567 F R
:LVNONE
  0 R

# =====================================================================
#  main loop and dispatcher
# =====================================================================

:MAIN
  # ---- write the string table into memory (generated) ----
  108 3688 T  115 3689 T  0 3690 T   # c_ls
