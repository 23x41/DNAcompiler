# =====================================================================
#  help
# =====================================================================

:C_HELP
  CYEL C "GATC SAK - swiss army knife (all tools written in GATC assembly)" CRST C CR CR
  CBLU C "browse   " CRST C "ls [-l -a -h -d] [path...]   ll   cd [dir]   pwd   tree [-a] [dir]" CR
  "         find [path...] [-name PAT] [-iname PAT] [-type f|d|l]" CR
  "         stat file...   realpath path...   du [-s -h] [path...]   df [path]" CR
  CBLU C "files    " CRST C "cp [-r -v] src... dest   mv [-v] src... dest   rm [-r -f -v] path..." CR
  "         touch file...   mkdir [-p -v] dir...   rmdir dir...   ln [-s] target [link]" CR
  "         chmod 755|u+x,go-w file..." CR
  CBLU C "text     " CRST C "cat [-n] file...   cat > file  (type lines, end with a line holding only .)" CR
  "         head [-n N] file...   tail [-n N] file...   wc [-l -w -c] file..." CR
  "         grep [-i -n -v -c -l -r] TEXT file...   echo [-n] words" CR
  CBLU C "bytes    " CRST C "xxd [-n LEN] file...   hexdump   crc32 file..." CR
  CBLU C "other    " CRST C "date   whoami   clear   help   exit [code]" CR CR
  "Wildcards * and ? work in the last part of a path:  rm *.tmp   cp src/*.aa backup/" CR
  "Quotes and \\ escape spaces:  cat \"my file.txt\"   Redirect output:  ls -l > list.txt  >> appends" CR
  R
